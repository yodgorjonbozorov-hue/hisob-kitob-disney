{
  "expo": {
    "name": "BALANSA",
    "slug": "balansa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "balansa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "uz.balansa.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera mahsulot shtrix-kodi va QR kodlarini skanerlash uchun ishlatiladi.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.balansa.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1220",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera mahsulot shtrix-kodi va QR kodlarini skanerlash uchun ishlatiladi."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "BALANSA_EAS_PROJECT_ID_SHU_YERGA"
      }
    }
  }
}
