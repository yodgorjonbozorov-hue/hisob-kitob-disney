generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite native enumlarni qo'llab-quvvatlamaydi, shuning uchun rol/turi String sifatida
// saqlanadi va zod orqali ilova darajasida "admin"|"kassir" / "kirim"|"chiqim" bilan cheklanadi.

/// Tenant — mijoz kompaniya (obuna egasi). Har bir tenant o'z bizneslari va
/// foydalanuvchilariga ega; tenantlar bir-birining ma'lumotini hech qachon ko'rmaydi.
/// status: "TRIAL" | "ACTIVE" | "PAST_DUE" | "BLOCKED" (zod bilan cheklanadi).
model Tenant {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  status           String          @default("TRIAL")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  plan             String          @default("STANDARD")
  /// Doimiy bepul foydalanish (hamkor/o'z kompaniyasi). To'lov va muddat
  /// talab qilinmaydi: obuna tugasa ham kirish yopilmaydi, eslatma yuborilmaydi.
  /// Bloklash bundan ustun turadi.
  bepul            Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  businesses       Business[]
  users            User[]
  subscriptions    Subscription[]
  payments         Payment[]
  modules          TenantModule[]
  roles            Role[]
  supportTickets   SupportTicket[]

  @@index([status])
  /// Superadmin paneli tenantlarni sana bo'yicha saralaydi va sahifalaydi.
  @@index([createdAt])
}

/// MAXSUS ROL — mijoz o'zi yaratadigan rol (PRO tarif).
///
/// Tizim rollari (OWNER/ADMIN/CASHIER/SELLER) kodda qoladi — ular modul/nav
/// skeletini beradi. Maxsus rol esa GRANULAR huquqlar to'plami: mijoz
/// "Taminotchi", "Omborchi", "Haydovchi" kabi istalgan rol yaratadi va unga
/// kerakli huquqlarni (lib/permissions/katalog.ts kodlari) belgilaydi.
///
/// `bazaRol` — nav/modul darajasidagi skelet ("ADMIN" | "CASHIER" | "SELLER"):
/// maxsus rolli foydalanuvchi qaysi tizim roli kabi sahifalarni ko'rishini
/// aniqlaydi; granular huquqlar shu skelet ichida qo'llanadi.
model Role {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nomi      String
  izoh      String?
  /// Huquq kodlari JSON massivi, masalan ["mahsulot.korish","pul.berish"].
  huquqlar  String    @default("[]")
  /// "ADMIN" | "CASHIER" | "SELLER" — nav skeleti (yuqoridagi izoh).
  bazaRol   String    @default("SELLER")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  users     User[]

  @@unique([tenantId, nomi])
  @@index([tenantId, isActive])
}

/// Tenant qaysi modullarni yoqqani. Modul katalogi kodda (lib/modules/registry.ts) —
/// bu jadval faqat yoqilganlik holati. Core modullar yozuvsiz ham yoqilgan hisoblanadi.
model TenantModule {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code       String // registry'dagi modul kodi (masalan "OMBOR")
  isActive   Boolean  @default(true)
  sozlamalar String? // modul-spetsifik sozlamalar (JSON)
  createdAt  DateTime @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Obuna davri — har tasdiqlangan to'lov bitta davr yozuvini yaratadi (tarix uchun).
/// status: "ACTIVE" | "EXPIRED" | "CANCELLED" (zod bilan cheklanadi).
model Subscription {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan        String
  status      String   @default("ACTIVE")
  periodStart DateTime
  periodEnd   DateTime
  amount      Int
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([status])
  /// "Yaqinda tugaydigan obunalar" kesimi.
  @@index([periodEnd])
}

/// To'lov yozuvi. provider: "MANUAL" | "PAYME" | "CLICK";
/// status: "PENDING" | "CONFIRMED" | "REJECTED". MANUAL'da SUPERADMIN tasdiqlaydi.
model Payment {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  amount            Int
  provider          String    @default("MANUAL")
  /// Provider tranzaksiya IDsi. @unique — bitta provider tranzaksiyasi ikki marta
  /// yozilmasligi uchun (webhook takroriy so'rov yuborishi mumkin).
  externalId        String?   @unique
  status            String    @default("PENDING")
  /// Qaysi tarif uchun to'lov — tasdiqda tenant.plan shu qiymatga o'tadi (upgrade oqimi).
  plan              String?
  izoh              String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  /// Onlayn provider tranzaksiyasi holati. Payme: 1 (yaratildi), 2 (bajarildi),
  /// -1 (yaratilgach bekor), -2 (bajarilgach bekor). Click: 1/2/-1.
  providerState     Int?
  /// Provider tranzaksiyasi yaratilgan payt (Payme create_time).
  providerCreatedAt DateTime?
  cancelTime        DateTime?
  /// Payme bekor qilish sababi kodi.
  cancelReason      Int?

  @@index([tenantId])
  @@index([status])
  /// Billing sahifasi to'lovlarni sana bo'yicha sahifalaydi.
  @@index([createdAt])
}

/// Biznes (kompaniya bo'limi). Har bir biznesning o'z kategoriyalari, tranzaksiyalari va dashboard'i.
model Business {
  id                 String                   @id @default(cuid())
  nomi               String
  isActive           Boolean                  @default(true)
  // Ombor (inventar) tizimi yoqilganmi — tovar sotadigan bizneslar uchun (masalan Salyut).
  omborli            Boolean                  @default(false)
  // Biznes turi: "umumiy" | "avto". Avto — olib-sotarlar uchun (ombor → avtopark).
  // Faqat UI matnlari va sotuv qoidalariga ta'sir qiladi (lib/biznesTuri.ts).
  turi               String                   @default("umumiy")
  /// BIZNES YO'NALISHI (sanoat) — tariflar sahifasida tanlangan soha
  /// (lib/pricing/profil.ts: "food" | "service" | "agro" ...). FAQAT
  /// shaxsiylashtirish uchun: onboarding qadamlari va tavsiyalar shu
  /// yo'nalishga moslashadi. NARXGA va hisob mantiqiga TA'SIR QILMAYDI.
  /// null — eski bizneslar va yo'nalishsiz ro'yxatdan o'tganlar.
  yonalish           String?
  /// SHAXSIY KASSA REJIMI. Yoqilganda har xodimning naqd yozuvi UMUMIY kassaga
  /// emas, O'ZINING shaxsiy kassasiga (Account.userId) tushadi — "kimning
  /// qo'lida qancha pul bor" savoliga ledger javob beradi.
  ///
  /// Bayroq ATAYLAB opt-in: yoqilmagan bizneslarda kassa tanlash mantig'i
  /// avvalgidek qoladi (lib/services/accounts.ts → resolveAccountId).
  shaxsiyKassa       Boolean                  @default(false)
  /// MAGAZIN (POS) shu bizneste yuritiladimi. MAGAZIN moduli TENANT darajasida
  /// yoqiladi, bu bayroq esa BIZNES darajasida — bir tenantda do'kon ham,
  /// do'kon bo'lmagan biznes ham yonma-yon tura oladi (`omborli` bilan bir xil
  /// qoida). Mavjud bizneslarda `false` — ular uchun hech narsa o'zgarmaydi.
  magazin            Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  tenantId           String
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  categories         Category[]
  transactions       Transaction[]
  users              User[]
  products           Product[]
  budgets            Budget[]
  shiftCloses        ShiftClose[]
  recurrings         RecurringTransaction[]
  sales              Sale[]
  debts              Debt[]
  stockEntries       StockEntry[]
  debtPayments       DebtPayment[]
  auditLogs          AuditLog[]
  contacts           Contact[]
  stages             Stage[]
  deals              Deal[]
  crmActivities      Activity[]
  tasks              Task[]
  productExpenses    ProductExpense[]
  accounts           Account[]
  transfers          AccountTransfer[]
  adjustments        StockAdjustment[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseItems      PurchaseOrderItem[]
  approvalRules      ApprovalRule[]
  approvalRequests   ApprovalRequest[]
  employees          Employee[]
  attendances        Attendance[]
  payrolls           Payroll[]
  advances           PayrollAdvance[]
  contracts          Contract[]
  attachments        Attachment[]
  dailyReports       DailyReport[]
  dailyTransactions  DailyTransaction[]
  dailyReportSetting DailyReportSetting?
  smenalar           Smena[]
  kassaTopshiriqlar  CashHandover[]
  productCategories  ProductCategory[]
  posCheklar         PosChek[]
  /// Ko'p-bizneslik biriktiruvlari (UserBusiness) — bir xodim bir nechta
  /// bizneste ishlashi mumkin.
  userBiriktiruvlar  UserBusiness[]
  // Davomat 2.0 (selfie/GPS) modullari
  workLocations      WorkLocation[]
  workSchedules      WorkSchedule[]
  workScheduleDays   WorkScheduleDay[]
  attendanceChecks   AttendanceCheck[]
  attendanceSelfies  AttendanceSelfie[]
  penaltyRules       PenaltyRule[]
  penalties          EmployeePenalty[]
  bonuses            EmployeeBonus[]
  employeePlans      EmployeePlan[]
  hrSetting          HrSetting?
  // Xodim kategoriyalari (CRM zakaz-xodim biriktiruvi)
  employeeCategories EmployeeCategory[]
  categoryAzolar     EmployeeCategoryMember[]
  dealEmployees      DealEmployee[]
  dealFeedbacks      DealFeedback[]
  // Xodimlar KPI / ball / oylik moduli
  kpiSetting         KpiSetting?
  kpiBracketlar      KpiSalesBracket[]
  kpiBallQoidalari   KpiScoreRule[]
  kpiVazifalar       KpiTask[]
  kpiBiriktiruvlar   KpiTaskAssignment[]
  kpiPresetlar       KpiPenaltyPreset[]
  kpiBallLoglari     KpiPointLog[]
  kpiSotuvPlanlari   KpiSalesTarget[]
  kpiOyliklar        KpiPayroll[]
  kpiOylikQatorlari  KpiPayrollItem[]
  kpiTuzatishlar     KpiPayrollAdjustment[]

  @@index([tenantId])
}

model User {
  id                 String            @id @default(cuid())
  ism                String
  login              String            @unique
  parolHash          String
  // rol: "SUPERADMIN" | "OWNER" | "ADMIN" | "CASHIER" | "SELLER" (zod bilan cheklanadi).
  rol                String
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  lastLoginAt        DateTime?
  // Seed parollarini birinchi kirishda majburiy almashtirish uchun.
  mustChangePassword Boolean           @default(false)
  /// SUPERADMIN ICHIDAGI ROL (Superadmin 2.0). Faqat `rol = "SUPERADMIN"` bo'lganda
  /// ma'noga ega: "ROOT" | "ADMIN" | "SUPPORT" | "FINANCE" | "ANALYST" | "READ_ONLY".
  ///
  /// DEFAULT ATAYLAB YO'Q. Oddiy (tenant) foydalanuvchida bu ustun NULL bo'lib
  /// qoladi — u superadmin emas. Superadminda NULL uchrasa `lib/superadmin/rbac.ts`
  /// uni "ROOT" deb o'qiydi: 2.0 gacha HAR superadmin hamma narsani qila olardi,
  /// ya'ni NULL — aynan o'sha eski holat. Bu yerda "NULL -> ruxsat yo'q" deyish
  /// imtiyoz qo'shmaydi, faqat migratsiyadan oldingi hisoblarni tizimdan
  /// chiqarib yuborardi. Cheklangan rol ochiq tayinlanadi.
  superadminRol      String?
  /// SESSIYA AVLODI. Sessiya cookie'sida shu raqam saqlanadi; bazadagi qiymat
  /// oshirilsa, eski cookie'lar DARHOL kuchini yo'qotadi. Iron-session stateless
  /// bo'lgani uchun "sessiyani bekor qilish"ning yagona ishonchli yo'li shu.
  sessionEpoch       Int               @default(0)
  transactions       Transaction[]
  /// Sotuvchi sifatida biriktirilgan kirim yozuvlari (xodim statistikasi).
  sotuvYozuvlari     Transaction[]     @relation("SotuvchiYozuvlari")
  employees          Employee[]
  approvalRequests   ApprovalRequest[] @relation("TasdiqSorovchi")
  approvalDecisions  ApprovalRequest[] @relation("TasdiqQaror")

  // Tenant a'zoligi. Faqat SUPERADMIN (platforma egasi) uchun null.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// BIRLAMCHI BIZNES (ko'p-bizneslikdan keyingi ma'nosi).
  ///
  /// Biriktiruvlar endi `UserBusiness` jadvalida — bir xodim 1, 2 yoki undan
  /// ortiq biznesga biriktirilishi mumkin. Bu ustun esa QULAYLIK nusxasi:
  ///   · aynan BITTA biznesga biriktirilgan bo'lsa — o'sha biznes id'si
  ///     (kassir/sotuvchi yozuvlari doim shu biznesga tushadi, adashmaydi);
  ///   · biriktirilmagan YOKI 2+ biznesga biriktirilgan bo'lsa — NULL.
  /// Ya'ni "NULL" endi "biriktirilmagan" degani EMAS: haqiqiy ruxsat ro'yxati
  /// `UserBusiness` da (lib/business.ts). Bu ustunga tayanadigan eski kod
  /// (bot, sessiya) shu bois xato ruxsat bermaydi — u faqat "bitta biznesga
  /// qotirilganmi" savoliga javob beradi.
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  /// Xodim kira oladigan bizneslar (ko'p-bizneslik). Bo'sh bo'lsa — cheklov
  /// yo'q (tenant ichidagi barcha bizneslar), direktor/administratordagi kabi.
  bizneslar UserBusiness[]

  telegramChatId    String?   @unique
  linkCode          String?
  linkCodeExpiresAt DateTime?

  // MAXSUS ROL (PRO): tayinlangan bo'lsa granular huquqlar shu roldan olinadi,
  // `rol` esa rol.bazaRol bilan sinxron saqlanadi (nav/modul skeleti uchun).
  roleId     String?
  role       Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// Foydalanuvchiga ALOHIDA berilgan qo'shimcha huquqlar (JSON massiv).
  huquqPlus  String?
  /// Foydalanuvchidan ALOHIDA olib qo'yilgan huquqlar (JSON massiv).
  huquqMinus String?

  /// Shaxsiy kassalar (Account.userId) — har user o'z hamyoniga ega bo'la oladi.
  shaxsiyKassalar Account[] @relation("KassaEgasi")

  supportTickets  SupportTicket[]  @relation("TiketMuallifi")
  supportOwned    SupportTicket[]  @relation("TiketMasuli")
  supportMessages SupportMessage[]

  @@index([businessId])
  @@index([tenantId])
  @@index([roleId])
  /// Superadmin global foydalanuvchilar ro'yxati rol bo'yicha filtrlanadi.
  @@index([rol])
}

/// FOYDALANUVCHI ↔ BIZNES BIRIKTIRUVI (ko'p-bizneslik).
///
/// Nega kerak: bitta jamoa bir nechta biznesni yuritadi (masalan "Disney
/// Flowers" va "Disney Giftbox" — sotuvchilar bir xil, bizneslar esa hisob-kitob
/// chalkashmasligi uchun alohida). Ilgari xodim FAQAT bitta biznesga
/// biriktirilardi: ikkinchi bizneste ishlash uchun ikkinchi login kerak edi.
///
/// Qoida: qatorlari bor xodim FAQAT shu bizneslarga kiradi; qatori yo'q xodim
/// — cheklovsiz (tenant ichidagi barcha bizneslar). Ruxsatning YAGONA manbai
/// shu jadval (`lib/business.ts`).
model UserBusiness {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())
  /// Biriktiruv — foydalanuvchining o'zi bilan yashaydi: hisob o'chirilsa
  /// qator ham ketadi (tarixiy qiymati yo'q).
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// Bir xodim bir biznesga ikki marta biriktirilmaydi.
  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

/// Kalit-qiymat ko'rinishidagi tizim sozlamalari (masalan, oxirgi yuborilgan oylik hisobot).
model AppSetting {
  key   String @id
  value String
}

/// AI COPILOT SUHBATI — server tomonda saqlanadi.
///
/// Nega serverda: ilgari suhbat tarixi mijozdan (brauzerdan) kelardi.
/// Foydalanuvchi soxta `assistant` xabarini yuborib modelni chalg'itishi
/// mumkin edi (prompt injection). Endi mijoz faqat SAVOL va suhbat ID'sini
/// yuboradi, tarix esa shu jadvaldan olinadi.
///
/// Bitta foydalanuvchi + biznes uchun BIR NECHTA suhbat bo'ladi ("Yangi
/// suhbat" har safar yangi qator ochadi) — avvalgi `AiConversation` bitta
/// faol suhbat bilan cheklangan edi va chat tarixi umuman yo'q edi.
/// Egalik kaliti — (businessId, userId): boshqa foydalanuvchining suhbati
/// hech qachon o'qilmaydi.
model AiSuhbat {
  id         String   @id @default(cuid())
  tenantId   String
  businessId String
  userId     String
  /// Ro'yxatda ko'rinadigan qisqa nom — birinchi savoldan kesib olinadi
  /// (AI chaqirilmaydi: sarlavha uchun token sarflashning ma'nosi yo'q).
  sarlavha   String
  /// Xabarlar JSON massivi:
  /// [{ rol: "user" | "assistant", matn: string, havolalar?: [...], takliflar?: [...] }]
  xabarlar   String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([businessId, userId, updatedAt])
  @@index([tenantId, updatedAt])
}

/// Telegram botdagi ko'p qadamli suhbat holati (/kirim, /lead, /mashina, /sotish).
///
/// Nega bazada: production'da bot serverless webhook orqali ishlaydi — har so'rov
/// boshqa instansiyaga tushishi mumkin, xotiradagi Map bilan oqim o'rtada uziladi.
/// Bitta chat bir vaqtda bitta oqimda bo'ladi, shuning uchun kalit — chatId.
///
/// Bu VAQTINCHALIK holat: zaxira ro'yxatiga (lib/backup/dump.ts) ATAYLAB
/// qo'shilmagan va 24 soatdan keyin cron tomonidan tozalanadi.
model BotConversation {
  chatId    String   @id
  /// Qaysi oqim: "transaction" | "lead" | "avto"
  flow      String
  /// Oqim holati (JSON)
  state     String
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// PUL MANBAI — kassa yoki hisob-raqam (naqd, plastik, bank).
///
/// Ilgari hamma pul bitta "qop"da edi: naqd sotuv ham, plastik ham, bankdagi
/// pul ham bir joyda ko'rinardi. Endi har tranzaksiya qaysi kassaga
/// tushganini bildiradi va har kassaning o'z qoldig'i bo'ladi.
model Account {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  nomi             String
  /// "naqd" | "plastik" | "bank"
  turi             String            @default("naqd")
  /// SHAXSIY KASSA EGASI (PRO): null — umumiy biznes kassasi (avvalgi xatti-harakat);
  /// to'ldirilgan — shu foydalanuvchining shaxsiy hamyoni. Balans baribir
  /// ledger'dan (Transaction + AccountTransfer) hisoblanadi.
  userId           String?
  user             User?             @relation("KassaEgasi", fields: [userId], references: [id], onDelete: SetNull)
  isActive         Boolean           @default(true)
  tartib           Int               @default(0)
  createdAt        DateTime          @default(now())
  transactions     Transaction[]
  chiqishlar       AccountTransfer[] @relation("transferFrom")
  kirishlar        AccountTransfer[] @relation("transferTo")
  approvalRequests ApprovalRequest[]

  @@unique([businessId, nomi])
  @@index([businessId, isActive, tartib])
}

/// KASSALAR ARO PUL KO'CHIRISH (masalan kassadan bankka).
///
/// Ataylab Transaction YOZMAYDI: bu kirim ham, chiqim ham emas — pul biznes
/// ichida joyini o'zgartirdi. Aks holda kunlik kirim/chiqim sun'iy oshib
/// ketardi. Kassa qoldig'i hisobida esa alohida hisobga olinadi.
model AccountTransfer {
  id                   String    @id @default(cuid())
  businessId           String
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  fromAccountId        String
  fromAccount          Account   @relation("transferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId          String
  toAccount            Account   @relation("transferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  summa                Int
  /// Valyuta — hozircha faqat "UZS" (butun tizim so'mda, Int).
  valyuta              String    @default("UZS")
  sana                 DateTime
  izoh                 String?
  userId               String
  // FOYDALANUVCHIDAN FOYDALANUVCHIGA O'TKAZMA (PRO): shaxsiy kassalar orasidagi
  // transfer kim kimga pul berganini ham yozadi. Ism — snapshot (ShiftClose
  // uslubi): foydalanuvchi o'chirilsa ham tarix o'qiladigan bo'lib qoladi.
  fromUserId           String?
  fromUserIsm          String?
  toUserId             String?
  toUserIsm            String?
  /// "transfer" — oddiy pul ko'chirish; "smena" — smena topshirish
  /// (kassir kassasini keyingi kassirga/direktorga topshiradi).
  /// Faqat KO'RSATISH va hisobot uchun — pul harakati ikkalasida bir xil.
  turi                 String    @default("transfer")
  /// "bajarildi" | "kutilmoqda" | "rad" | "bekor" | "arxiv".
  ///
  /// QOLDIQQA KIRADIGANLAR: "bajarildi" va "bekor".
  ///   - "kutilmoqda" — qabul qiluvchi hali tasdiqlamagan; pul YUBORUVCHIDA
  ///     turaveradi (limbo bo'lmasin). Ikki marta sarflanmasligi uchun yangi
  ///     o'tkazmada kutilayotgan chiqim mavjud qoldiqdan ayriladi.
  ///   - "rad" — qabul qiluvchi rad etdi; pul umuman ko'chmagan.
  ///   - "bekor" — STORNO bilan bekor qilingan: qarama-qarshi yo'nalishda
  ///     yangi transfer yoziladi (ledger append-only), asl yozuv shu bayroq
  ///     bilan belgilanadi. Shuning uchun u qoldiqda QOLADI — storno uni
  ///     nolga chiqaradi.
  ///   - "arxiv" — eski `CashHandover` tizimidan ko'chirilgan TARIX yozuvi.
  ///     Legacy tizim ATAYLAB ledgerga tegmasdi, shuning uchun bu qatorlar
  ///     ham pul ko'chirmaydi: ular faqat "kim kimga qachon topshirdi"
  ///     tarixini bitta joyda ko'rsatish uchun (scripts/kassa-handover-migratsiya.ts).
  holat                String    @default("bajarildi")
  /// Ko'chirilgan `CashHandover` yozuvining IDsi. UNIQUE — migratsiya
  /// idempotent: qayta ishga tushirilsa dublikat yaratilmaydi.
  legacyCashHandoverId String?   @unique
  /// Qabul qilgan/rad etgan foydalanuvchi. Ism — snapshot (tarix o'qiladigan qolsin).
  tasdiqlaganId        String?
  tasdiqlaganIsm       String?
  tasdiqlanganAt       DateTime?
  radAt                DateTime?
  /// Rad etish yoki bekor qilish sababi (qabul qiluvchi yozadi).
  qarorIzoh            String?
  /// KASSA TOPSHIRISH SNAPSHOTI (`turi = "smena"` da to'ldiriladi; boshqa
  /// o'tkazmalarda null). Topshirish PAYTIDA server hisoblagan kassa
  /// qoldig'i — kutilayotgan chiqim ayrilgan holda. MUZLATILADI: qaror
  /// kutayotgan paytda kassaga yangi yozuv tushsa ham topshirish farqi
  /// o'zgarmaydi, aks holda direktor tasdiqlayotgan raqam u ko'rgan
  /// raqamdan boshqa bo'lib qolardi.
  hisoblangan          Int?
  /// `summa − hisoblangan` — KASSA FARQI. Manfiy = kamomad (kassir tizim
  /// hisobidan kam topshirdi; qolgani uning kassasida ochiq turadi).
  /// Manfiy qoldiq taqiqlangani uchun bu qiymat hech qachon musbat
  /// bo'lmaydi — mavjud qoldiqdan ko'p pul o'tkazib bo'lmaydi.
  farq                 Int?
  /// Bog'liq hujjat: "purchaseOrder" | "debt" | "storno" (+ relatedId).
  relatedType          String?
  relatedId            String?
  createdAt            DateTime  @default(now())

  @@index([businessId, sana])
  @@index([businessId, fromUserId])
  @@index([businessId, toUserId])
  /// Kutilayotgan o'tkazmalar paneli — eng ko'p o'qiladigan so'rov.
  @@index([businessId, holat, createdAt])
}

model Category {
  id               String                 @id @default(cuid())
  nomi             String
  turi             String
  tartib           Int                    @default(0)
  isActive         Boolean                @default(true)
  /// KG ASOSIDA SAVDO (mijozga xos — Fortex Selos, lib/mijozXos.ts).
  /// Bu kategoriya tanlanganda summa qo'lda kiritilmaydi: miqdor (kg) va
  /// 1 kg narxi so'raladi, summa shundan hisoblanadi. Kategoriyaga NARX
  /// QOTIRILMAYDI — narx har savdoda erkin.
  kgAsosli         Boolean                @default(false)
  createdAt        DateTime               @default(now())
  businessId       String
  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  budgets          Budget[]
  recurrings       RecurringTransaction[]
  approvalRules    ApprovalRule[]
  approvalRequests ApprovalRequest[]
  debts            Debt[]
  /// CRM kunlik buyurtmalari — KATEGORIYA MANBAI BITTA: CRM alohida
  /// kategoriya tizimi qurmaydi, aynan shu jadvaldan foydalanadi.
  deals            Deal[]

  /// DIQQAT: bu cheklov registrga SEZGIR ("Bantik" ≠ "bantik"). Registrga
  /// befarq yagonalik esa IFODALI indeks bilan beriladi — `lower(trim("nomi"))`
  /// bo'yicha, migratsiya `20260825130000_kategoriya_registrsiz_unique` da.
  /// Prisma sxemasi ifodali indeksni ifodalay olmaydi, shuning uchun u faqat
  /// SQL'da yashaydi (Postgres yo'li: scripts/pg-migratsiya.mjs, QOLDA bloki).
  @@unique([nomi, turi, businessId])
  @@index([turi, isActive])
  @@index([businessId])
}

model Transaction {
  id              String           @id @default(cuid())
  turi            String
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Qaysi kassa/hisob-raqamga tushdi. Eski yozuvlar uchun null — migratsiya
  /// skripti (scripts/kassa-migratsiya.ts) ularni default kassaga bog'laydi.
  accountId       String?
  account         Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// To'lov turi: "naqd" | "click" | "qarz". Null — eski yozuvlar, ularda tur
  /// kassa (account.turi) dan chiqariladi. "qarz"da pul kassaga tushmagan,
  /// shuning uchun accountId null bo'ladi va kassa qoldig'iga kirmaydi.
  tolovTuri       String?
  summa           Int
  /// KG SAVDOSI (mijozga xos — Fortex Selos, lib/mijozXos.ts).
  /// Miqdor GRAMDA butun son sifatida saqlanadi (100,5 kg → 100500): og'irlik
  /// ham pul kabi float bo'lmasligi kerak, aks holda 100.5 × 5000 kabi oddiy
  /// hisobda ham yaxlitlash xatosi paydo bo'ladi.
  /// null — kg savdosi emas (barcha oddiy va eski yozuvlar).
  miqdorGr        Int?
  /// Shu savdodagi 1 kg narxi (so'm). MUZLATILGAN snapshot: narx kategoriyaga
  /// qotirilmagan — sotuvchi har savdoda o'zi kiritadi, keyingi savdo boshqa
  /// narxda bo'lsa ham bu yozuv o'zgarmaydi. `summa` = miqdorGr × kgNarxi / 1000
  /// (server tomonda qayta hisoblanadi — lib/kg.ts).
  kgNarxi         Int?
  sana            DateTime
  izoh            String?
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// SOTUVCHI/XODIM — savdo kimning hisobiga yozilishi. `userId` dan farqi:
  /// `userId` — yozuvni KIM KIRITGANI (audit), `sotuvchiId` — savdo KIMNIKI
  /// (xodim statistikasi). Null — eski yozuvlar va sotuvsiz tizim yozuvlari
  /// (qarz to'lovi, oylik); statistika ular uchun `userId` ga tayanadi
  /// (lib/queries/xodimStatistika.ts). Faqat kirim uchun ma'noga ega.
  sotuvchiId      String?
  sotuvchi        User?            @relation("SotuvchiYozuvlari", fields: [sotuvchiId], references: [id], onDelete: SetNull)
  filial          String?
  createdAt       DateTime         @default(now())
  // Soft delete — o'chirilgan yozuv shu vaqt bilan belgilanadi (undo/savat uchun).
  deletedAt       DateTime?
  /// Tasdiqdan o'tib yozilgan bo'lsa — o'sha so'rov (aks holda null).
  approvalRequest ApprovalRequest?
  /// HR: shu tranzaksiya oylik yoki avans to'lovi bo'lsa — o'sha yozuv.
  payroll         Payroll?         @relation("OylikChiqimi")
  advance         PayrollAdvance?  @relation("AvansChiqimi")
  /// CRM: shu kirim CRM buyurtmasidan ko'chirilgan bo'lsa — o'sha buyurtma.
  /// Bog'lanish BIR-BIRGA (Deal.transactionId UNIQUE), ya'ni bitta kirim
  /// ortida ko'pi bilan bitta buyurtma turadi. Kirim ro'yxatidagi
  /// "Manba: CRM" belgisi shu bog'lanishdan o'qiladi.
  crmBuyurtma     Deal?            @relation("CrmBuyurtmaKirimi")

  // KOMPOZIT INDEKSLAR: SQLite bitta so'rovda bitta indeks ishlatadi, shuning uchun
  // 6 ta bitta-ustunli indeks deyarli foydasiz edi (va har yozuvni sekinlashtirardi).
  // Barcha real so'rovlar businessId + (filtr) + sana ko'rinishida bo'ladi.
  @@index([businessId, deletedAt, sana])
  @@index([businessId, turi, deletedAt, sana])
  @@index([businessId, categoryId, sana])
  @@index([businessId, userId, sana])
  // Quyidagi ikkitasi FILTR uchun emas — `onDelete: Restrict` tekshiruvi uchun:
  // kategoriya/foydalanuvchi o'chirilayotganda SQLite bola jadvalni skanerlaydi.
  @@index([categoryId])
  @@index([userId])
  @@index([businessId, accountId, sana])
  /// Xodim statistikasi kesimi (biznes + sotuvchi + davr) va `SetNull` tekshiruvi.
  @@index([businessId, sotuvchiId, sana])
  @@index([sotuvchiId])
}

/// Audit izi — har bir muhim o'zgarish (kim, nima, oldin→keyin) yoziladi.
model AuditLog {
  id         String    @id @default(cuid())
  /// Qaysi kompaniya (tenant) jurnaliga tegishli. SUPERADMIN amallarida null.
  /// businessId'siz yozuvlar (foydalanuvchi, biznes, modul) ham shu ustun
  /// orqali tenant bo'yicha filtrlanadi.
  tenantId   String?
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  userId     String?
  userIsm    String?
  action     String // "create" | "update" | "delete" | "restore"
  entity     String // "transaction" | "user" | "category" | "sale" | "debt"
  entityId   String
  before     String? // JSON
  after      String? // JSON
  ip         String?
  /// Brauzer/qurilma satri — imtiyozli amal qaysi mashinadan bajarilganini
  /// ko'rsatadi (Superadmin 2.0 xavfsizlik markazi).
  userAgent  String?
  /// Xavfli amal SABABI — superadmin bloklash/tarif/eksport kabi amallarda
  /// majburiy kiritadi (talab 46/57).
  sabab      String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([businessId, createdAt])
  @@index([entity])
  @@index([createdAt])
  /// Kim nima qilgani bo'yicha kesim — xavfsizlik markazi va "oxirgi faoliyat".
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Kassir kun yakuni — kutilgan naqd (kirim) vs sanalgan naqd, farq.
model ShiftClose {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId       String
  userIsm      String?
  sana         DateTime
  kutilganNaqd Int
  sanalganNaqd Int
  farq         Int
  izoh         String?
  createdAt    DateTime @default(now())

  @@index([businessId, sana])
}

/// Takroriy tranzaksiya andozasi — har oy `kun` sanasida avtomatik yaratiladi.
model RecurringTransaction {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  turi          String
  summa         Int
  izoh          String?
  kun           Int // oyning kuni (1-28)
  isActive      Boolean  @default(true)
  lastGenerated String? // oxirgi yaratilgan oy "YYYY-MM"
  createdAt     DateTime @default(now())

  @@index([businessId])
}

/// Kategoriya bo'yicha oylik budjet (limit). "oy" formati: "2026-07".
model Budget {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  oy         String
  limitSumma Int
  createdAt  DateTime @default(now())

  @@unique([categoryId, oy])
  @@index([businessId, oy])
}

// ==== Ombor (inventar) moduli — faqat omborli bizneslar uchun ====

/// Mahsulot turi (masalan salyut turlari) + narxlar + joriy qoldiq.
/// Avto rejimida (Business.turi = "avto") bitta yozuv = bitta avtomobil (miqdor 0/1).
model Product {
  id            String              @id @default(cuid())
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  nomi          String
  kelganNarx    Int                 @default(0) // tannarx (birlik)
  sotuvNarx     Int                 @default(0) // sotuv narxi (birlik)
  miqdor        Int                 @default(0) // ombordagi joriy qoldiq
  isActive      Boolean             @default(true)
  izoh          String?
  /// Ombor kodi (artikul). Ixtiyoriy, biznes ichida takrorlanmasin.
  sku           String?
  /// O'lchov birligi: "dona" | "kg" | "litr" | "metr" | "quti" | "paket".
  birlik        String              @default("dona")
  /// Shu miqdordan kam qolsa bildirishnoma chiqadi. 0 = ogohlantirish yo'q.
  /// Ilgari butun tizim uchun bitta sobit chegara (5 dona) ishlatilardi —
  /// tuxum sotuvchiga ham, avtomobil sotuvchiga ham bir xil edi.
  minQoldiq     Int                 @default(0)
  /// ZAVOD SHTRIX-KODI (EAN-13/UPC va h.k.) — quti ustidagi kod.
  /// Biznes ichida takrorlanmaydi (@@unique([businessId, barcode])); GLOBAL
  /// unique ATAYLAB emas: bir xil Coca-Cola'ni yuzlab do'kon sotadi va
  /// global cheklov ikkinchi mijozga mahsulot qo'shishga yo'l bermasdi.
  barcode       String?
  /// BALANSA QR — zavod kodi yo'q mahsulot uchun tizim yaratadigan barqaror
  /// identifikator ("BALANSA-PRODUCT-XXXXXXXX"). QR ichida FAQAT shu kalit
  /// bo'ladi: narx yoki qoldiq QR ichiga yozilmaydi, shuning uchun narx
  /// o'zgarganda chop etilgan stikerlarni qayta bosish shart emas.
  qrKod         String?
  /// Mahsulot rasmi (tashqi havola yoki saqlagich URL'i).
  rasmUrl       String?
  /// MAHSULOT KATEGORIYASI (POS'da guruhlab ko'rsatish uchun). `Category`
  /// modelidan ATAYLAB alohida: u kirim/chiqim moliyaviy kategoriyasi.
  categoryId    String?
  category      ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Avto rejimi maydonlari — umumiy bizneslarda null.
  avtoYil       Int?
  avtoRaqam     String?
  avtoRang      String?
  createdAt     DateTime            @default(now())
  stockEntries  StockEntry[]
  sales         Sale[]
  debts         Debt[]
  expenses      ProductExpense[]
  adjustments   StockAdjustment[]
  xaridSatrlari PurchaseOrderItem[]

  @@unique([businessId, barcode])
  @@unique([businessId, qrKod])
  @@index([businessId])
  @@index([businessId, sku])
  @@index([businessId, categoryId])
}

/// OMBOR TO'G'RILASH — inventarizatsiya yoki hisobdan chiqarish.
///
/// Ilgari qoldiqni to'g'rilashning YAGONA yo'li mahsulotni qo'lda tahrirlash
/// edi — kim, qachon va NEGA o'zgartirgani hech qayerda qolmasdi. Endi har
/// to'g'rilash sababi bilan yoziladi.
///
///   "inventarizatsiya" — sanaldi, haqiqiy qoldiq boshqa chiqdi (farq ±);
///   "chiqarish"        — buzildi/yo'qoldi/sovg'a qilindi (farq har doim −).
model StockAdjustment {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  turi        String
  eskiMiqdor  Int
  yangiMiqdor Int
  /// yangiMiqdor − eskiMiqdor (manfiy bo'lishi mumkin).
  farq        Int
  sabab       String
  userId      String
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([productId])
}

/// Mahsulot/mashinaga bog'langan xarajat (avto rejimida: ta'mirlash, bo'yoq,
/// yuvish, rasmiylashtirish). Sof foyda = sotuv − olingan narx − shu xarajatlar.
model ProductExpense {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// "tamirlash" | "boyoq" | "yuvish" | "rasmiylashtirish" | "ehtiyot_qism" | "boshqa"
  turi          String
  summa         Int
  izoh          String?
  userId        String
  /// Naqd to'langanda — bog'langan chiqim tranzaksiya.
  transactionId String?
  /// Keyin to'lanadigan bo'lsa — bog'langan "beriladigan" qarz.
  debtId        String?
  createdAt     DateTime @default(now())

  @@index([businessId])
  @@index([productId])
}

/// Ombor kirimi — mahsulot qoldig'ini oshiradi (chiqim tranzaksiya yaratmaydi).
model StockEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  miqdor     Int
  birlikNarx Int // o'sha paytdagi tannarx snapshot
  userId     String
  izoh       String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([productId])
}

/// Sotuv — mahsulot qoldig'ini kamaytiradi. Naqd → kirim tranzaksiya; qarz → Debt.
///
/// `sana` ALOHIDA maydon (createdAt emas): kechagi sotuvni bugun kiritish
/// mumkin bo'lishi kerak, aks holda u kechagi hisobotga tushmaydi.
/// `deletedAt` — xato kiritilgan sotuvni bekor qilish (kassa dasturi uchun shart).
model Sale {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  miqdor        Int
  birlikNarx    Int // sotuv narxi snapshot
  tannarx       Int // kelgan narx snapshot (marja hisobi uchun)
  jamiSumma     Int
  tolovTuri     String // "naqd" | "qarz"
  /// Mijoz kartochkasiga bog'lanish (ixtiyoriy — eski yozuvlarda null).
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  mijozNomi     String?
  mijozTel      String?
  userId        String
  transactionId String? // naqd bo'lsa bog'langan kirim tranzaksiya
  /// Sotuv sanasi (UTC yarim tuni). Migratsiyada createdAt dan to'ldiriladi.
  sana          DateTime
  createdAt     DateTime  @default(now())
  /// Bekor qilingan sotuv — yumshoq o'chirish (tarix saqlanadi).
  deletedAt     DateTime?
  cancelledBy   String?
  cancelReason  String?
  debt          Debt?
  /// POS CHEKI (MAGAZIN moduli). To'ldirilgan bo'lsa — bu sotuv savatdagi
  /// bitta satr; pul harakati va bekor qilish CHEK darajasida yuritiladi.
  /// null — oddiy bir mahsulotli sotuv (OMBOR moduli, avvalgi xatti-harakat).
  chekId        String?
  chek          PosChek?  @relation(fields: [chekId], references: [id], onDelete: Restrict)

  @@index([businessId, sana])
  @@index([chekId])
  @@index([businessId, deletedAt, sana])
  @@index([productId])
  @@index([contactId])
}

/// Qarzdorlik. Ikki yo'nalishli:
///  - turi = "olinadigan" — bizga qarzdor (qarzga sotuvdan avtomatik yoki qo'lda);
///  - turi = "beriladigan" — biz qarzdormiz (masalan mashina olindi, egasiga to'lanmadi).
/// To'lovlar bilan kamayadi: olinadigan → kirim tranzaksiya, beriladigan → chiqim.
model Debt {
  id                 String        @id @default(cuid())
  businessId         String
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  turi               String        @default("olinadigan")
  saleId             String?       @unique
  sale               Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  /// Qarz qaysi mahsulot/mashinaga tegishli (ixtiyoriy).
  productId          String?
  product            Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Mijoz kartochkasiga bog'lanish (ixtiyoriy — eski yozuvlarda null).
  contactId          String?
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  mijozNomi          String
  mijozTel           String?
  jamiSumma          Int
  tolangan           Int           @default(0)
  /// TARIXIY BAYROQ. `status` bilan har doim sinxron yuritiladi
  /// (PAID va CANCELLED — ikkalasi ham `true`), chunki ochiq qarz jamlari
  /// va mijoz limiti shu ustun bo'yicha hisoblanadi.
  isYopilgan         Boolean       @default(false)
  /// HOLAT: "OPEN" | "PARTIALLY_PAID" | "PAID" | "CANCELLED".
  /// `isYopilgan` faqat "yopiqmi" degan savolga javob berardi — qisman
  /// to'langan qarzni ochiqdan ajratib bo'lmasdi va bekor qilish yo'q edi.
  status             String        @default("OPEN")
  /// QARZ BERILGAN SANA (kun aniqligida, UTC-yarim tun). Eski yozuvlarda
  /// migratsiya uni `createdAt` dan to'ldiradi. Kirim sanasi bu EMAS —
  /// kirim faqat to'lov sanasi bilan yoziladi (lib/services/qarz.ts).
  sana               DateTime?
  /// Qaysi kategoriya hisobiga qarzga savdo yozildi (hisobot uchun, ixtiyoriy).
  categoryId         String?
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// MAS'UL SOTUVCHI/OPERATOR. FK ataylab yo'q (DailyReportSetting.direktorId
  /// uslubi) — xodim o'chirilsa qarz tarixi buzilmasin; ism snapshot sifatida
  /// saqlanadi. Tenant tekshiruvi xizmat qatlamida.
  masulId            String?
  masulIsm           String?
  /// ESKI YOZUVLAR KO'PRIGI: `tolovTuri = "qarz"` bilan yozilgan kirim
  /// tranzaksiyasidan ko'chirilgan qarz (scripts/qarz-migratsiya.ts).
  /// @unique — bitta tranzaksiya ikki marta ko'chirilmaydi (idempotentlik).
  /// FK yo'q: tranzaksiya yumshoq o'chirilsa ham bog'lanish o'qiladigan qoladi.
  manbaTransactionId String?       @unique
  /// Kelishilgan to'lov muddati (ixtiyoriy).
  muddat             DateTime?
  izoh               String?
  userId             String
  createdAt          DateTime      @default(now())
  /// AUDIT: oxirgi o'zgarish. Eski yozuvlarda null.
  updatedAt          DateTime?     @updatedAt
  updatedBy          String?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancelReason       String?
  payments           DebtPayment[]
  /// CRM zakazi shu qarzni ochgan bo'lsa — teskari bog'lanish (1:1).
  crmZakaz           Deal?         @relation("CrmBuyurtmaQarzi")

  @@index([businessId, isYopilgan, turi])
  @@index([businessId, turi])
  @@index([businessId, contactId, isYopilgan])
  @@index([businessId, status, turi])
  @@index([businessId, sana])
  @@index([productId])
  @@index([contactId])
  @@index([categoryId])
}

// ==== XARID moduli (Faza 6.1) ====

/// TA'MINOTCHI — kimdan tovar olamiz.
///
/// CRM'dagi `Contact` mijozlar uchun; ta'minotchi esa boshqa tomon: undan
/// tovar olamiz va UNGA qarzdor bo'lamiz. Ikkalasini aralashtirish qarzdorlik
/// yo'nalishini chalkashtirardi.
model Supplier {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nomi       String
  /// TIZIM FOYDALANUVCHISIGA BOG'LASH (PRO): ta'minotchi tenant ichidagi user
  /// bo'lsa (masalan "Taminotchi" maxsus rolli), xarid to'lovi chiqim o'rniga
  /// uning SHAXSIY KASSASIGA transfer bilan yoziladi. FK ataylab yo'q
  /// (DailyReportSetting.direktorId uslubi) — user o'chirilsa reyestr buzilmasin;
  /// tenant tekshiruvi xizmat qatlamida (lib/services/xarid.ts).
  userId     String?
  tel        String?
  manzil     String?
  izoh       String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  deletedAt  DateTime?
  orders     PurchaseOrder[]
  contracts  Contract[]

  @@index([businessId, isActive])
  @@index([businessId, nomi])
}

/// XARID BUYURTMASI.
///
/// Holat oqimi: "qoralama" → "tasdiqlangan" → "qabul_qilingan" (yoki "bekor").
/// QABUL QILINGANDA (va faqat o'shanda) ombor va pul harakati yoziladi:
///   - har satr uchun StockEntry (qoldiq oshadi, tannarx snapshot);
///   - naqd bo'lsa chiqim tranzaksiya, qarzga bo'lsa "beriladigan" qarz.
/// Qoralama va tasdiqlangan buyurtma hech narsaga ta'sir qilmaydi — bu
/// ataylab: reja bilan haqiqat aralashmasligi kerak.
model PurchaseOrder {
  id             String              @id @default(cuid())
  businessId     String
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// "qoralama" | "tasdiqlangan" | "qabul_qilingan" | "bekor"
  holat          String              @default("qoralama")
  /// Buyurtma sanasi (reja).
  sana           DateTime
  /// Haqiqiy qabul qilingan payt.
  qabulSana      DateTime?
  /// "naqd" | "qarz" — qabul qilishda pul harakati shunga qarab yoziladi.
  tolovTuri      String              @default("naqd")
  /// Satrlar yig'indisi (qabul paytida qayta hisoblanadi).
  jamiSumma      Int                 @default(0)
  izoh           String?
  userId         String
  /// Qabul qilinganda yozilgan chiqim tranzaksiyasi (naqd bo'lsa).
  transactionId  String?
  /// Qabul qilinganda ochilgan "beriladigan" qarz (qarzga bo'lsa).
  debtId         String?
  /// QISMAN TO'LOV (PRO): qabul paytida to'langan qism (0..jamiSumma).
  /// Qolgani `debtId` dagi qarzga tushadi va DebtPayment bilan yopiladi.
  tolanganSumma  Int                 @default(0)
  /// Ta'minotchi tizim useri bo'lsa — qabul paytidagi kassa transferi.
  transferId     String?
  /// TAKROR YUBORISHDAN HIMOYA (idempotentlik kaliti).
  ///
  /// "Ta'minotni saqlash" tugmasi ikki marta bosilsa (yoki tarmoq javobni
  /// yo'qotib qayta yuborsa) ombor ikki marta oshib, qarz ikki marta
  /// yozilardi. Frontend har oqim uchun BITTA kalit yaratadi va uni
  /// har urinishda o'zgarmagan holda yuboradi; ikkinchi so'rov shu
  /// UNIQUE cheklovga uriladi va xizmat MAVJUD yozuvni qaytaradi.
  ///
  /// Himoya ATAYLAB bazada: ilova kodi ham, brauzer ham xato qilsa
  /// (yoki ikki so'rov bir vaqtda kelsa) baza ikkinchisini o'tkazmaydi.
  idempotencyKey String?
  /// Bekor qilingan payt (holat = "bekor" bo'lganda to'ldiriladi).
  bekorSana      DateTime?
  /// Bekor qilish sababi — auditda saqlanadi.
  bekorSabab     String?
  /// Kim bekor qilgani.
  bekorUserId    String?
  createdAt      DateTime            @default(now())
  items          PurchaseOrderItem[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, holat, sana])
  @@index([businessId, qabulSana])
  @@index([supplierId])
}

/// Xarid buyurtmasi satri — qaysi mahsulotdan qancha va qanday narxda.
model PurchaseOrderItem {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderId    String
  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  miqdor     Int
  /// Birlik narxi (tannarx). Qabul qilishda Product.kelganNarx shunga yangilanadi.
  birlikNarx Int
  jamiSumma  Int

  @@index([orderId])
  @@index([businessId])
}

// ==== CRM moduli (BOS-2) ====

/// Mijoz/kontakt — CRM'ning asosiy sub'ekti.
model Contact {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ism        String
  tel        String?
  telegram   String?
  /// Optom mijoz kartochkasi maydonlari: manzil va mas'ul shaxs.
  /// null — eski yozuvlar va chakana mijozlar (ixtiyoriy).
  manzil     String?
  masulShaxs String?
  izoh       String?
  createdBy  String
  /// Ochiq qarz shu chegaradan oshsa yangi qarzga sotuv rad etiladi.
  /// null — chegara yo'q (avvalgi xatti-harakat).
  qarzLimit  Int?
  createdAt  DateTime   @default(now())
  deletedAt  DateTime?
  deals      Deal[]
  activities Activity[]
  sales      Sale[]
  debts      Debt[]
  contracts  Contract[]
  posCheklar PosChek[]

  @@index([businessId])
  @@index([businessId, tel])
}

/// Sotuv bosqichi (kanban ustuni). turi: "OPEN" | "WON" | "LOST".
model Stage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nomi       String
  tartib     Int      @default(0)
  turi       String   @default("OPEN")
  deals      Deal[]

  @@index([businessId, tartib])
}

/// Bitim. Alohida "Lead" modeli YO'Q — birinchi bosqichdagi bitim = lead
/// (sodda UX, konvertatsiya bosqichi degan ortiqcha qadam yo'q).
model Deal {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  nomi          String
  summa         Int            @default(0)
  /// KUNLIK BUYURTMA: buyurtma kategoriyasi — KIRIM modulidagi AYNAN o'sha
  /// `Category`. CRM uchun alohida kategoriya tizimi YO'Q: buyurtma kirimga
  /// ko'chirilganda tranzaksiya shu kategoriya bilan yoziladi, shuning uchun
  /// Kirimdagi kategoriya filtri CRM yozuvlarini o'zi qamrab oladi.
  /// null — eski bitimlar (kategoriyasiz yaratilgan).
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stageId       String
  stage         Stage          @relation(fields: [stageId], references: [id], onDelete: Restrict)
  masulId       String // mas'ul xodim (foydalanuvchi)
  manba         String? // "qolda" | "telegram" | ...
  /// Buyurtma sanasi (UTC-yarim tun, `lib/date.ts`). "Bugungi buyurtmalar"
  /// paneli va kategoriya statistikasi shu maydon bo'yicha kesiladi.
  /// `muddat` bilan ARALASHTIRILMAYDI: `muddat` — kelishilgan muddat,
  /// `sana` — buyurtma qabul qilingan kun.
  sana          DateTime?
  muddat        DateTime?
  yopilganAt    DateTime?
  /// Shu buyurtmadan yozilgan KIRIM tranzaksiyasi.
  /// UNIQUE — bitta buyurtma hech qachon ikkita kirim yarata olmaydi.
  /// Himoya BAZA darajasida: frontend holatiga ham, faqat kod tekshiruviga
  /// ham tayanilmaydi (parallel ikki so'rovda ikkinchisi cheklovga uriladi).
  transactionId String?        @unique
  transaction   Transaction?   @relation("CrmBuyurtmaKirimi", fields: [transactionId], references: [id], onDelete: SetNull)
  /// ISH JARAYONI HOLATI — CRM doskasining YAGONA haqiqat manbai.
  /// "KUTILMOQDA" | "JARAYONDA" | "YUTILDI" | "YOQOTILDI".
  ///
  /// "Bugungi zakazlar" ALOHIDA holat EMAS: u `holat = KUTILMOQDA` va
  /// `sana = bugun` (Asia/Tashkent) shartidan HISOBLANADI. Shu sabab kun
  /// almashganda hech narsa yozilmaydi — kunlik cron ham, qo'lda ko'chirish
  /// ham kerak emas. Kechagi bajarilmagan zakaz ham yo'qolmaydi: u
  /// KUTILAYOTGAN ustunida "kechikkan" belgisi bilan qoladi.
  ///
  /// `stageId` bilan ALOQASI: bosqich shu holatdan KELIB CHIQIB sinxron
  /// yuritiladi (`lib/crm/pipeline.ts`), chunki dashboard, AI analitikasi va
  /// xodim reytingi hali `Stage.turi` (OPEN/WON/LOST) ni o'qiydi. Haqiqat
  /// manbai bitta — `holat`; bosqich uning ko'zgusi.
  holat         String         @default("KUTILMOQDA")
  /// TO'LANGAN summa (so'm). TO'LOV HOLATI shu maydondan hisoblanadi
  /// (`lib/crm/pipeline.ts` → `tolovHolati`): to'liq / qisman / qarzga.
  /// Alohida `paymentStatus` ustuni ATAYLAB yo'q — u ikkinchi haqiqat
  /// manbai bo'lib summa bilan zid holatga tushib qolardi.
  tolangan      Int            @default(0)
  /// Pul qaysi kanal bilan keldi: "naqd" | "click" | "qarz".
  /// Kirim tranzaksiyasiga o'sha ko'rinishda uzatiladi.
  tolovTuri     String?
  /// YUTILDI bosilganda to'lanmagan qism uchun ochilgan QARZ yozuvi.
  /// UNIQUE — bitta zakaz hech qachon ikkita qarz yarata olmaydi (kirim
  /// bilan bir xil himoya: kafolat BAZA darajasida).
  debtId        String?        @unique
  debt          Debt?          @relation("CrmBuyurtmaQarzi", fields: [debtId], references: [id], onDelete: SetNull)
  izoh          String?
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?
  activities    Activity[]
  tasks         Task[]
  /// Zakazda qatnashgan xodimlar (kategoriya kesimida).
  xodimlar      DealEmployee[]
  /// Sifat nazorati — mijoz fikri (bir zakazga bitta).
  feedback      DealFeedback?

  @@index([businessId, stageId])
  @@index([businessId, masulId])
  /// "Bugungi buyurtmalar" va kategoriya statistikasi — eng ko'p o'qiladigan kesim.
  @@index([businessId, sana])
  /// CRM doskasining asosiy kesimi: holat + sana (ustunlar shu ikkovidan
  /// hisoblanadi).
  @@index([businessId, holat, sana])
  @@index([categoryId])
}

// ==== Vazifalar moduli (BOS-3) ====

/// Vazifa. holat: "OCHIQ" | "JARAYONDA" | "BAJARILDI" (sobit 3 ustun — sodda kanban)
/// + "BEKOR" (xodim vazifalarida bekor qilingan; kanban ustunlariga tushmaydi).
/// "Kechikdi" ALOHIDA holat EMAS — u `muddat < bugun` va yopilmaganlikdan
/// hisoblab chiqariladi (ikkinchi haqiqat manbai bo'lmasin).
model Task {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nomi        String
  izoh        String?
  holat       String    @default("OCHIQ")
  masulId     String // mas'ul foydalanuvchi
  /// XODIM VAZIFASI (HR moduli): vazifa qaysi xodim kartochkasiga tegishli.
  /// `masulId` (User) dan farqi: xodim tizimga kirmasligi mumkin — bunda
  /// `masulId` vazifani bergan boshqaruvchida qoladi, `employeeId` esa
  /// xodim statistikasi va plan hisobining kaliti. Null — oddiy CRM vazifasi.
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// Muhimlik: "past" | "orta" | "yuqori".
  muhimlik    String    @default("orta")
  /// Boshlanish sanasi (UTC-yarim tun). Null — darhol (createdAt).
  boshlanish  DateTime?
  muddat      DateTime?
  dealId      String? // CRM bitimiga bog'lash (ixtiyoriy)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdBy   String
  bajarildiAt DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([businessId, holat])
  @@index([businessId, masulId])
  @@index([businessId, muddat])
  /// Xodim vazifalari kesimi (kartochka/plan hisobi) va `SetNull` tekshiruvi.
  @@index([businessId, employeeId, holat])
  @@index([employeeId])
}

/// CRM faoliyati (timeline): izoh, qo'ng'iroq, uchrashuv, tizim yozuvi.
model Activity {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  turi       String // "izoh" | "qongiroq" | "uchrashuv" | "tizim"
  matn       String
  userId     String
  createdAt  DateTime @default(now())

  @@index([businessId, dealId])
  @@index([businessId, contactId])
}

/// Qarz to'lovi — kirim tranzaksiya yaratadi va qarzni kamaytiradi.
model DebtPayment {
  id             String    @id @default(cuid())
  debtId         String
  debt           Debt      @relation(fields: [debtId], references: [id], onDelete: Restrict)
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  summa          Int
  /// TO'LOV SANASI — pul HAQIQATDA kelgan kun. Kirim tranzaksiyasi aynan shu
  /// sana bilan yoziladi, qarz berilgan sana bilan EMAS. Eski yozuvlarda
  /// migratsiya uni `createdAt` dan to'ldiradi.
  sana           DateTime?
  /// Qaysi usulda to'landi: "naqd" | "click" | "bank". Eski yozuvlarda null.
  tolovTuri      String?
  /// Qaysi kassaga tushdi. Kirim tranzaksiyasi ham shu kassaga bog'lanadi.
  accountId      String?
  izoh           String?
  userId         String
  transactionId  String?
  /// TAKROR TO'LOVDAN HIMOYA: klient har to'lov uchun bir martalik kalit
  /// yuboradi. Tugma ikki marta bosilsa ikkinchi so'rov shu unique cheklovga
  /// uriladi va mavjud to'lov qaytariladi — balans ikki marta oshmaydi.
  idempotencyKey String?
  createdAt      DateTime  @default(now())

  @@unique([debtId, idempotencyKey])
  @@index([debtId])
  @@index([businessId])
  @@index([businessId, sana])
}

/// TASDIQLASH QOIDASI — qaysi chiqim rahbar tasdig'isiz o'tmaydi.
///
/// Nega kerak: kassir yoki sotuvchi istalgan summani chiqim qilib yozib
/// yuborardi — direktor buni faqat oy oxirida hisobotda ko'rardi. Endi
/// chegaradan oshgan chiqim darhol yozilmaydi, "kutilmoqda" holatiga
/// tushadi va Telegramdagi tugma bilan tasdiqlanadi yoki rad etiladi.
///
/// `categoryId` null bo'lsa — qoida BARCHA chiqim kategoriyalariga tegishli.
/// Bir nechta qoida mos kelsa, eng QATTIQI (chegarasi eng pasti) ishlaydi.
model ApprovalRule {
  id              String            @id @default(cuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Shu summadan KATTA chiqim tasdiq talab qiladi (so'm, Int).
  chegara         Int
  /// Kim tasdiqlaydi: "OWNER" | "ADMIN".
  tasdiqlovchiRol String            @default("OWNER")
  isActive        Boolean           @default(true)
  izoh            String?
  createdAt       DateTime          @default(now())
  deletedAt       DateTime?
  requests        ApprovalRequest[]

  @@index([businessId, isActive, deletedAt])
  @@index([categoryId])
}

/// TASDIQ SO'ROVI — hali yozilmagan chiqim.
///
/// Bu tranzaksiya EMAS: hisobotlarga, kassa qoldig'iga va budjetga ta'sir
/// qilmaydi. Tasdiqlangandagina haqiqiy `Transaction` yoziladi va shu yerga
/// `transactionId` bilan bog'lanadi — kim so'ragani va kim tasdiqlagani
/// keyin ham ko'rinib turadi.
model ApprovalRequest {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  ruleId         String?
  rule           ApprovalRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  accountId      String?
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  summa          Int
  sana           DateTime
  izoh           String?
  filial         String?
  /// "kutilmoqda" | "tasdiqlangan" | "rad"
  holat          String        @default("kutilmoqda")
  /// So'rovni yuborgan xodim.
  userId         String
  user           User          @relation("TasdiqSorovchi", fields: [userId], references: [id], onDelete: Restrict)
  tasdiqlovchiId String?
  tasdiqlovchi   User?         @relation("TasdiqQaror", fields: [tasdiqlovchiId], references: [id], onDelete: SetNull)
  qarorSana      DateTime?
  radSabab       String?
  transactionId  String?       @unique
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([businessId, holat, createdAt])
  @@index([businessId, userId])
  @@index([categoryId])
  @@index([accountId])
  @@index([userId])
  @@index([tasdiqlovchiId])
  @@index([ruleId])
}

// ==== HR-LITE moduli (Faza 6.4) ====

/// XODIM KARTOCHKASI — `User` dan ataylab ajratilgan.
///
/// `User` — tizimga KIRADIGAN hisob. Xodimlarning ko'pchiligi esa tizimga
/// umuman kirmaydi (yuk tashuvchi, oshpaz, farrosh), lekin ularga oylik
/// to'lanadi. Ikkalasini bitta jadvalga tiqish "loginsiz foydalanuvchi"
/// degan g'alati yozuvlarni tug'dirardi. `userId` — ixtiyoriy ko'prik.
model Employee {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Tizim hisobi bilan bog'lanish (ixtiyoriy).
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  ism          String
  lavozim      String?
  tel          String?
  /// Profil rasmi (blob URL yoki tashqi havola). Null — UI bosh harfli
  /// avatar ko'rsatadi. Selfie EMAS: bu ochiq ko'rinadigan profil surati.
  rasmUrl      String?
  /// Stavka (so'm). `stavkaTuri` ga qarab oylik yoki bir kunlik.
  stavka       Int       @default(0)
  /// "oylik" | "kunlik"
  stavkaTuri   String    @default("oylik")
  ishBoshlagan DateTime?
  isActive     Boolean   @default(true)
  izoh         String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  // ---- Davomat 2.0 (selfie/GPS) siyosati ----
  /// Ish jadvali. NULL — biznesning standart jadvali qo'llanadi.
  workScheduleId String?
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  /// Ish joyi (GPS radius). NULL — biznes standart ish joyi qo'llanadi.
  workLocationId String?
  workLocation   WorkLocation? @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  /// Davomat siyosati: har xodimga alohida sozlanadi (ofis/dala/masofaviy).
  selfieTalab    Boolean       @default(true)
  gpsTalab       Boolean       @default(true)
  /// false — GPS yoziladi, lekin ish joyi radiusi TEKSHIRILMAYDI (dala xodimi).
  radiusTalab    Boolean       @default(true)

  attendances      Attendance[]
  payrolls         Payroll[]
  advances         PayrollAdvance[]
  checks           AttendanceCheck[]
  selfies          AttendanceSelfie[]
  penalties        EmployeePenalty[]
  bonuses          EmployeeBonus[]
  plans            EmployeePlan[]
  vazifalar        Task[]
  /// Kategoriya a'zoliklari (Sotuvchi/Diktor/... — bir xodim bir nechtasida bo'la oladi).
  kategoriyalar    EmployeeCategoryMember[]
  /// Zakazlarda qatnashuvlari (CRM buyurtma biriktiruvlari).
  zakazlari        DealEmployee[]
  /// KPI moduli: biriktirilgan vazifalar, ball tarixi, sotuv plani, oyliklar.
  kpiBiriktiruvlar KpiTaskAssignment[]
  kpiBallLoglari   KpiPointLog[]
  kpiSotuvPlanlari KpiSalesTarget[]
  kpiOyliklar      KpiPayroll[]

  @@index([businessId, isActive, deletedAt])
  @@index([userId])
  @@index([workScheduleId])
  @@index([workLocationId])
}

/// DAVOMAT — bir xodim, bir kun, bir yozuv.
///
/// `holat`: "keldi" | "yarim" | "kelmadi" | "tatil". Kunlik stavkada oylik
/// shu yozuvlardan hisoblanadi. Yarim kunni kasr bilan saqlamaslik uchun
/// `Payroll.yarimKunlar` ikkilangan sonda yuritiladi (1 kun = 2).
model Attendance {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sana       DateTime
  holat      String   @default("keldi")
  izoh       String?
  createdAt  DateTime @default(now())

  // ---- Davomat 2.0: kelish/ketish vaqtlari (server soati, UTC) ----
  kelganVaqt       DateTime?
  ketganVaqt       DateTime?
  /// Xom kechikish (daqiqa): jadval boshlanishidan keyin kelgan vaqt.
  kechikishDaqiqa  Int       @default(0)
  /// Jarima hisobiga o'tadigan kechikish: imtiyoz (grace) ichida bo'lsa 0.
  jarimaDaqiqa     Int       @default(0)
  ertaKetishDaqiqa Int       @default(0)
  ortiqchaDaqiqa   Int       @default(0)
  ishlanganDaqiqa  Int       @default(0)
  /// Jadval SNAPSHOT'i — keyin jadval o'zgarsa ham hisob auditga ochiq qoladi.
  rejaBoshlanish   String?
  rejaTugash       String?
  rejaImtiyoz      Int?
  /// Tekshiruv manbai: "selfie_gps" | "admin" | "kamera" (Faza 2). NULL — eski qo'lda yozuv.
  manba            String?

  checks    AttendanceCheck[]
  penalties EmployeePenalty[]

  @@unique([employeeId, sana])
  @@index([businessId, sana])
  @@index([employeeId, sana])
}

/// AVANS — oy o'rtasida berilgan pul.
///
/// Avans DARHOL chiqim tranzaksiyasi yozadi: pul haqiqatan kassadan chiqdi.
/// Oy yopilganda esa u `Payroll.avans` sifatida hisobdan chegiriladi —
/// aks holda bir xil pul ikki marta chiqim bo'lib ko'rinardi.
model PayrollAdvance {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Qaysi oyning oyligidan chegiriladi — "YYYY-MM".
  oy            String
  summa         Int
  sana          DateTime
  izoh          String?
  transactionId String?      @unique
  transaction   Transaction? @relation("AvansChiqimi", fields: [transactionId], references: [id], onDelete: SetNull)
  userId        String
  createdAt     DateTime     @default(now())

  @@index([businessId, oy])
  @@index([employeeId, oy])
  @@index([transactionId])
}

/// OYLIK VEDOMOSTI — bir xodim, bir oy.
///
/// `qoralama` holatida hech qanday pul yozuvi yo'q: bu hali hisob-kitob.
/// `tolangan` holatida `tolanadigan` summa bitta chiqim tranzaksiyasiga
/// aylanadi (avans allaqachon chiqim bo'lgani uchun undan chegirilgan).
model Payroll {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// "YYYY-MM"
  oy            String
  /// Kunlik stavkada — davomatdan hisoblangan ikkilangan kunlar (1 kun = 2).
  yarimKunlar   Int          @default(0)
  /// Stavka bo'yicha asosiy hisob.
  hisoblangan   Int          @default(0)
  /// Ustama/mukofot (qo'lda kiritiladi).
  qoshimcha     Int          @default(0)
  /// Ushlab qolish (qo'lda kiritiladi: yetishmovchilik va sh.k.).
  ushlab        Int          @default(0)
  /// Davomat 2.0: shu oydagi bonuslar yig'indisi (EmployeeBonus, snapshot).
  bonuslar      Int          @default(0)
  /// Davomat 2.0: TASDIQLANGAN jarimalar yig'indisi (EmployeePenalty, snapshot).
  jarimalar     Int          @default(0)
  /// Shu oyda berilgan avanslar yig'indisi (snapshot).
  avans         Int          @default(0)
  /// hisoblangan + qoshimcha - ushlab - avans (manfiy bo'lmaydi).
  tolanadigan   Int          @default(0)
  /// "qoralama" | "tolangan"
  holat         String       @default("qoralama")
  tolanganSana  DateTime?
  transactionId String?      @unique
  transaction   Transaction? @relation("OylikChiqimi", fields: [transactionId], references: [id], onDelete: SetNull)
  izoh          String?
  userId        String
  createdAt     DateTime     @default(now())

  @@unique([employeeId, oy])
  @@index([businessId, oy, holat])
  @@index([transactionId])
}

// ==== DAVOMAT 2.0 (Xodimlar moduli: selfie + GPS + jadval + jarima) ====

/// ISH JOYI — davomat GPS tekshiruvi uchun nuqta (ofis, do'kon, filial).
/// Radius ichida check-in qabul qilinadi (Haversine, server tomonda).
model WorkLocation {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nomi       String
  lat        Float
  lng        Float
  /// Ruxsat etilgan radius (metr).
  radiusM    Int       @default(100)
  /// Biznes standart ish joyi — xodimga alohida biriktirilmagan bo'lsa shu olinadi.
  standart   Boolean   @default(false)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  employees Employee[]
  checks    AttendanceCheck[]

  @@index([businessId, isActive])
}

/// ISH JADVALI — haftalik shablon. Kunlari `WorkScheduleDay` da.
/// Direktor/Admin tuzadi va xodimlarga biriktiradi; xodim faqat ko'radi.
model WorkSchedule {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nomi          String
  /// Kechikish imtiyozi (daqiqa): shu chegaragacha "vaqtida" hisoblanadi.
  imtiyozDaqiqa Int       @default(5)
  /// Biznes standart jadvali — xodimga alohida biriktirilmagan bo'lsa shu olinadi.
  standart      Boolean   @default(false)
  /// Jadval shu sanadan kuchga kiradi (NULL — darhol).
  kuchgaKirgan  DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  kunlar    WorkScheduleDay[]
  employees Employee[]

  @@index([businessId, isActive])
}

/// JADVAL KUNI — haftaning bir kuni (0=Yakshanba ... 6=Shanba, JS getUTCDay).
/// `ishKuni=false` — dam olish kuni; u kelmaganlik hisoblanMAYDI.
model WorkScheduleDay {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  hafta      Int
  ishKuni    Boolean      @default(true)
  /// "HH:MM" — Toshkent vaqti bo'yicha ish boshlanishi.
  boshlanish String?
  /// "HH:MM" — Toshkent vaqti bo'yicha ish tugashi.
  tugash     String?

  @@unique([scheduleId, hafta])
  @@index([businessId])
}

/// DAVOMAT TEKSHIRUVI — har bir kelish/ketish hodisasining O'ZGARMAS dalili.
/// Admin tuzatishi ham yangi yozuv sifatida qo'shiladi (asl dalil o'chmaydi).
/// Faza 2 (kamera/yuz tanish) shu jadvalga "kamera" manbali yozuv qo'shadi.
model AttendanceCheck {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  attendanceId   String
  attendance     Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "kelish" | "ketish"
  turi           String
  /// SERVER vaqti (UTC) — mijoz soatiga hech qachon ishonilmaydi.
  vaqt           DateTime
  /// "selfie_gps" | "admin" | "kamera" (Faza 2)
  manba          String            @default("selfie_gps")
  lat            Float?
  lng            Float?
  /// GPS aniqligi (metr, qurilma bergan accuracy).
  aniqlikM       Int?
  /// Ish joyigacha hisoblangan masofa (metr, Haversine).
  masofaM        Int?
  ruxsatRadiusM  Int?
  workLocationId String?
  workLocation   WorkLocation?     @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  selfieId       String?           @unique
  selfie         AttendanceSelfie? @relation(fields: [selfieId], references: [id], onDelete: SetNull)
  /// Admin tuzatishda: kim, nima sababdan, avvalgi qiymat nima edi.
  userId         String?
  sabab          String?
  oldingiVaqt    DateTime?
  createdAt      DateTime          @default(now())

  @@index([businessId, vaqt])
  @@index([attendanceId])
  @@index([employeeId, vaqt])
  @@index([workLocationId])
}

/// DAVOMAT SELFIESI — maxfiy shaxsiy ma'lumot. Ochiq URL YO'Q: faqat
/// avtorizatsiyalangan `/api/hr/davomat/selfie/[id]` orqali beriladi.
/// `saqlagich`: "blob" (Vercel Blob, url to'ldiriladi) | "db" (mazmun base64 —
/// blob sozlanmagan muhitda zaxira yo'l, qat'iy hajm chegarasi bilan).
model AttendanceSelfie {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "kelish" | "ketish"
  turi       String
  saqlagich  String
  url        String?
  mazmun     String?
  mimeType   String
  hajm       Int
  createdAt  DateTime @default(now())

  check AttendanceCheck?

  @@index([businessId, employeeId, createdAt])
}

/// JARIMA QOIDASI — biznes o'zi sozlaydi (hardcode YO'Q).
/// turi "kechikish": [minDaqiqa..maxDaqiqa] oralig'iga tushgan xom kechikish.
/// turi "kelmadi": kelmagan kun uchun bir martalik summa (daqiqa maydonlari 0).
model PenaltyRule {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  turi       String    @default("kechikish")
  minDaqiqa  Int       @default(0)
  /// NULL — yuqori chegara yo'q (masalan "31+ daqiqa").
  maxDaqiqa  Int?
  summa      Int
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  penalties EmployeePenalty[]

  @@index([businessId, isActive])
}

/// XODIM JARIMASI — avtomatik (davomatdan) yoki qo'lda. Oylikka FAQAT
/// "tasdiqlandi" holatidagilar kiradi; "kutilmoqda"/"rad" hisobga olinmaydi.
model EmployeePenalty {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceId   String?
  attendance     Attendance?  @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  ruleId         String?
  rule           PenaltyRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  sana           DateTime
  summa          Int
  /// Asl (avtomatik hisoblangan) summa — tasdiqda tahrirlangan bo'lsa farq ko'rinadi.
  aslSumma       Int
  sabab          String
  /// "avto" | "qolda"
  manba          String       @default("avto")
  /// "kutilmoqda" | "tasdiqlandi" | "rad"
  holat          String       @default("kutilmoqda")
  tasdiqlaganId  String?
  tasdiqlanganAt DateTime?
  radEtganId     String?
  radEtilganAt   DateTime?
  izoh           String?
  /// Qo'lda yaratganda — kim.
  userId         String?
  createdAt      DateTime     @default(now())

  @@index([businessId, holat, sana])
  @@index([employeeId, sana])
  @@index([attendanceId])
  @@index([ruleId])
}

/// XODIM BONUSI — direktor/admin beradi. Oylik hisobida qo'shiladi.
model EmployeeBonus {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sana       DateTime
  summa      Int
  sabab      String
  izoh       String?
  userId     String
  createdAt  DateTime @default(now())

  @@index([businessId, sana])
  @@index([employeeId, sana])
}

/// XODIM OYLIK PLANI — bir xodim, bir oy, bitta yozuv (Payroll uslubi).
///
/// Har oy ALOHIDA saqlanadi: keyingi oy plan o'zgarsa o'tgan oy statistikasi
/// buzilmaydi. NATIJA (actual) bazada SAQLANMAYDI — u har o'qishda manbadan
/// hisoblanadi (lib/queries/xodimPlan.ts), aks holda ikkita haqiqat manbai
/// paydo bo'lardi:
///   "zakaz"  — kirim tranzaksiyalari soni (sotuvchi kesimi, qarz to'lovisiz;
///              CRM zakazi kirimga 1-1 bog'langani uchun BIR marta sanaladi);
///   "savdo"  — o'sha tranzaksiyalar summasi;
///   "kirim"  — haqiqatda kelib tushgan pul (qarzga savdo emas, to'lovlar bilan);
///   "vazifa" — oy ichida bajarilgan xodim vazifalari soni (Task.employeeId).
model EmployeePlan {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "YYYY-MM"
  oy         String
  /// "zakaz" | "savdo" | "kirim" | "vazifa"
  planTuri   String   @default("zakaz")
  /// Maqsad: zakaz/vazifa — dona; savdo/kirim — so'm (Int).
  maqsad     Int
  izoh       String?
  /// Kim belgilagan (User.id). FK ataylab yo'q (EmployeeBonus.userId uslubi) —
  /// foydalanuvchi o'chirilsa plan tarixi buzilmasin.
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, oy])
  @@index([businessId, oy])
}

// ==== Xodim kategoriyalari va zakaz-xodim biriktiruvi ====

/// XODIM KATEGORIYASI (yo'nalish) — biznes o'zi sozlaydi (Sotuvchi, Diktor,
/// Dekoratsiyachi, Shofer, Animator, ...). Qattiq kodlangan ro'yxat YO'Q.
/// `turi` KPI uslubini belgilaydi (nomga bog'lanmaydi):
///   "sotuvchi" — savdo KPI (summa, konversiya, plan) — zakaz kimniki;
///   "ijrochi"  — bajarilgan ish soni KPI (Diktor/Shofer/Videochi kabi).
/// O'CHIRISH YO'Q — faqat `aktiv=false` (tarixiy biriktiruvlar saqlansin).
model EmployeeCategory {
  id                   String   @id @default(cuid())
  businessId           String
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nomi                 String
  turi                 String   @default("ijrochi")
  aktiv                Boolean  @default(true)
  tartib               Int      @default(0)
  /// ZAKAZGA BIRIKTIRISH MUMKINMI. `false` — lavozim faqat HR ro'yxati uchun
  /// (masalan Administrator): CRM "Yangi zakaz" formasida chiqmaydi.
  zakazgaBiriktiriladi Boolean  @default(true)
  /// BIR ZAKAZGA BIR NECHTA XODIM (multi-select): Videochi, Bezakchi kabi
  /// lavozimlarda yoqiladi. `false` — bir zakazda shu lavozimdan BITTA xodim
  /// (server ham majburlaydi). Baza tuzilmasi ikkalasini ham sig'diradi —
  /// bayroq faqat biznes qoidasi, sxema cheklovi emas.
  kopXodim             Boolean  @default(false)
  /// IJROCHI OYLIGI: shu lavozimda BIR zakazga chiqqani uchun haq (so'm).
  /// 0 — bu lavozim zakaz soniga qarab to'lanmaydi. Oylik hisobi
  /// TASDIQLANGAN biriktiruvlardan chiqadi (`DealEmployee.tasdiqlangan`),
  /// ya'ni xodimning tizim hisobi (`Employee.userId`) bo'lishi SHART EMAS.
  zakazHaqi            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  azolar        EmployeeCategoryMember[]
  biriktiruvlar DealEmployee[]

  @@unique([businessId, nomi])
  @@index([businessId, aktiv, tartib])
}

/// Kategoriya a'zoligi — bir xodim bir nechta kategoriyada bo'la oladi.
/// A'zolikdan chiqarish tarixga TA'SIR QILMAYDI: zakaz biriktiruvlari
/// (DealEmployee) alohida jadvalda turadi va o'chirilmaydi.
model EmployeeCategoryMember {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  category   EmployeeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([categoryId, employeeId])
  @@index([businessId, employeeId])
  @@index([employeeId])
}

/// ZAKAZDAGI XODIM — buyurtmada qaysi xodim qaysi yo'nalishda qatnashgani.
/// MOLIYAVIY YOZUV EMAS: pul faqat Deal.transactionId (CRM→Kirim) orqali,
/// bu jadval faqat samaradorlik statistikasi uchun o'qiladi.
/// UNIQUE(dealId, categoryId, employeeId) — kelajakda bir kategoriyaga bir
/// nechta xodim ham katta o'zgarishsiz sig'adi.
/// Kategoriya/xodimga `Restrict` — tarixiy biriktiruv tasodifan yo'qolmasin
/// (ikkalasi ham amalda soft o'chiriladi, hard delete bloklanadi).
model DealEmployee {
  id                String           @id @default(cuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dealId            String
  deal              Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  categoryId        String
  category          EmployeeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// SIFAT NAZORATI: shu xodimning shu zakazdagi ishiga baho (1..10).
  /// Null — baholanmagan. Xodim profilidagi "O'rtacha baho" shu ustunning
  /// AVG'i — alohida hisoblagich saqlanmaydi (haqiqat manbai — biriktiruv).
  baho              Int?
  bahoIzoh          String?
  bahoAt            DateTime?
  /// ATTRIBUTION TASDIG'I. `true` — odam tanlagan (yoki tanlanganini
  /// tasdiqlagan). `false` — mashina taxmin qilgan TAKLIF: formada
  /// oldindan ko'rinadi, lekin KPI va oylikka KIRMAYDI. Avtomatik
  /// migratsiya yozgan biriktiruvni shu bayroq bilan "kutilmoqda" holatiga
  /// olib qo'yish mumkin — o'chirish shart emas, tarix yo'qolmaydi.
  tasdiqlangan      Boolean          @default(true)
  /// Kim tasdiqladi (User.id). Null — hali hech kim.
  tasdiqlaganUserId String?
  createdAt         DateTime         @default(now())

  @@unique([dealId, categoryId, employeeId])
  /// Kategoriya analitikasi (davr kesimida xodim reytingi) — asosiy o'qish.
  @@index([businessId, categoryId, employeeId])
  @@index([businessId, employeeId])
  /// Oylik hisobi: xodimning davr ichidagi TASDIQLANGAN qatnashuvlari.
  @@index([businessId, employeeId, tasdiqlangan])
  @@index([dealId])
  @@index([categoryId])
  @@index([employeeId])
}

/// ZAKAZ SIFAT NAZORATI — butun zakazga tegishli mijoz fikri (bir zakazga
/// BITTA yozuv, `dealId` UNIQUE). Xodimga tegishli baho bu yerda EMAS —
/// u `DealEmployee.baho` da, o'sha biriktiruv bilan birga turadi.
/// Baholar 1..10 (validatsiya qatlami majburlaydi). Pul yozilmaydi.
model DealFeedback {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dealId       String   @unique
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// Umumiy servis bahosi (1..10). Null — berilmagan.
  servisBahosi Int?
  /// Mijoz e'tirozi (bo'lsa).
  etiroz       String?
  /// Nimani yaxshilash kerak (ichki xulosa).
  yaxshilash   String?
  /// Kim yozdi (User.id) — audit uchun; FK ataylab yo'q (foydalanuvchi
  /// o'chirilsa ham fikr qolsin).
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId, createdAt])
}

/// HR SOZLAMALARI — bir biznesga bitta yozuv (DailyReportSetting uslubi).
model HrSetting {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Xodim o'z oyligini (vedomost) ko'ra oladimi.
  xodimOylikKoradi    Boolean  @default(false)
  /// CRM: yangi zakazda SOTUVCHI majburiymi (Disney Navoiy uchun yoqiladi).
  /// Biznesga sozlanadi — boshqa Balansa bizneslarida xulq o'zgarmasin:
  /// default `false` (mavjud bizneslarda hech narsa qattiqlashmaydi).
  /// Faqat biznesda FAOL "sotuvchi" turidagi kategoriya bo'lsa kuchga kiradi,
  /// aks holda zakaz umuman yaratib bo'lmasdi.
  crmSotuvchiMajburiy Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ==== KUNLIK HISOBOT moduli ====

/// KUNLIK HISOBOT — bir biznes + bir sana = BITTA hisobot.
///
/// Oylik hisobotdan ATAYLAB alohida tizim: kunlik tushumlar (naqd/Click/qarz)
/// `Transaction` jadvaliga YOZILMAYDI, shuning uchun mavjud oylik hisobot,
/// kassa qoldig'i va budjetga umuman ta'sir qilmaydi.
///
/// Summalar har mutatsiyada DailyTransaction'lardan tranzaksiya ichida QAYTA
/// hisoblanadi — frontenddan kelgan songa ishonilmaydi.
///
/// `sana` — Toshkent (Asia/Tashkent, UTC+5) kalendar kuni, UTC yarim tun
/// sifatida saqlanadi. Kun O'zbekiston yarim tunida almashadi.
///
/// holat: "OPEN" | "SUBMITTED" | "CONFIRMED".
///   OPEN      — kun ochiq, tushum kiritiladi;
///   SUBMITTED — xodim kassani TOPSHIRDI (sanagan naqdini kiritib), direktor
///               tasdig'ini kutmoqda. Bu holatda ham tushum kiritilmaydi;
///   CONFIRMED — direktor tasdiqladi.
/// Yakunlangan (SUBMITTED/CONFIRMED) kunga tushum kiritib/o'zgartirib
/// bo'lmaydi — avval direktor/boshqaruvchi uni qayta ochadi.
model DailyReport {
  id             String             @id @default(cuid())
  businessId     String
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  sana           DateTime
  holat          String             @default("OPEN")
  naqdSumma      Int                @default(0)
  clickSumma     Int                @default(0)
  qarzSumma      Int                @default(0)
  /// naqd + click + qarz (backend formulasi, jamlashTx).
  jamiSumma      Int                @default(0)
  /// KASSA TOPSHIRISH (pul nazorati): xodim kun oxirida kassadagi naqdni
  /// SANAB kiritadi. Direktor `sanalganNaqd` ni tizim hisoblagan `naqdSumma`
  /// bilan solishtiradi — farq pul yo'qolganini (yoki ortiqchasini) darhol
  /// ko'rsatadi. Ism snapshot — xodim o'chirilsa ham tarix qoladi.
  submittedBy    String?
  submittedByIsm String?
  submittedAt    DateTime?
  sanalganNaqd   Int?
  /// TIZIM HISOBI — topshirish paytida MUZLATILADI: kassirning shaxsiy
  /// kassasidagi (yoki biznes naqd kassalaridagi) qoldiq. `naqdSumma` dan
  /// FARQI: bu yerda naqd CHIQIM va kun boshidagi qoldiq ham hisobga olinadi.
  /// Farq aynan shunga qarab o'lchanadi (`naqdSumma` ga emas).
  kutilganNaqd   Int?
  /// sanalganNaqd − kutilganNaqd. Manfiy = KAMOMAD, musbat = ORTIQCHA.
  /// Muzlatilgan: keyin yozuv tahrirlansa ham kun farqi o'zgarmaydi.
  kassaFarq      Int?
  /// KUN TOPSHIRIG'INING PUL HARAKATI — `AccountTransfer` IDsi.
  /// Topshirishda "kutilmoqda" holatida yaraladi, kun tasdiqlanganda
  /// "bajarildi" ga o'tadi (kassir kassasi kamayadi, direktornikiga qo'shiladi).
  /// NULL — pul ko'chmagan kun (naqd 0 yoki shaxsiy kassa rejimi yo'q).
  /// FK ATAYLAB yo'q: o'tkazma storno bilan bekor qilinsa ham havola qolsin.
  transferId     String?
  /// Kassirning topshirish izohi (farq bo'lsa MAJBURIY — validatsiyada).
  izoh           String?
  /// Direktor qarorining izohi (ayniqsa rad etishda).
  qarorIzoh      String?
  /// Tasdiqlagan foydalanuvchi (User.id) va ism snapshot'i — foydalanuvchi
  /// keyin o'chirilsa ham tarixda kim tasdiqlagani ko'rinib turadi.
  confirmedBy    String?
  confirmedByIsm String?
  confirmedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          DailyTransaction[]

  @@unique([businessId, sana])
  @@index([businessId, holat, sana])
}

/// Kunlik hisobot tushumi. tolovTuri: "CASH" | "CLICK" | "DEBT".
///
/// `userIsm` — kiritgan xodim ismining snapshot'i (ShiftClose uslubi):
/// User'ga FK yo'q, xodim o'chirilsa ham "kim kiritgani" tarixda qoladi.
model DailyTransaction {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reportId      String
  report        DailyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  summa         Int
  tolovTuri     String
  izoh          String?
  userId        String
  userIsm       String?
  /// Yozuvlar (Transaction) dan AVTOMATIK ulangan bo'lsa — o'sha yozuv IDsi.
  /// Bugungi sanali kirim tranzaksiyasi kunlikka o'zi tushadi (kunlikSinxron);
  /// boshqa sana tanlangan yozuv tushmaydi. FK ataylab yo'q — tranzaksiyani
  /// butunlay o'chirishni to'sib qo'ymasin; sinxron xizmat qatlamida.
  transactionId String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  /// Yumshoq o'chirish — o'chirilgan tushum jamiga kirmaydi, tarixda qoladi.
  deletedAt     DateTime?

  @@index([reportId, deletedAt])
  @@index([businessId, deletedAt, createdAt])
}

/// KUNLIK HISOBOT SOZLAMASI — biznes uchun tayinlangan direktor.
///
/// Kun yakunini FAQAT shu direktor tasdiqlaydi (tayinlanmagan bo'lsa,
/// vaqtincha OWNER/ADMIN tasdiqlay oladi). `direktorId` — User.id;
/// FK ataylab yo'q: foydalanuvchi o'chirilsa sozlama yozuvi buzilmasin,
/// tenant/biznes tekshiruvi xizmat qatlamida (setKunlikDirektor).
model DailyReportSetting {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  direktorId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// SMENA YAKUNI — kun ichida kassani bir necha marta sanab topshirish.
///
/// Nega kerak: ikki sotuvchi navbatma-navbat ishlaganda kunlik JAMI raqam
/// kimning puli qancha ekanini ko'rsatmaydi — kam chiqsa aybdorni topib
/// bo'lmaydi. Smena yopilganda o'sha oynadagi tushum MUZLATILADI, xodim
/// kassadagi naqdni SANAB kiritadi va farq shu qatorda qoladi. Keyingi
/// smena esa 0 dan (yoki ataylab qoldirilgan qaytim pulidan) boshlanadi.
///
/// KIRIM/CHIQIMGA TEGMAYDI: smena — kun ichidagi KESIM, hosila ko'rinish.
/// Bu yerda hech qanday Transaction ham, DailyTransaction ham yozilmaydi,
/// shuning uchun kunlik va oylik raqamlar avvalgidek qoladi.
///
/// OYNA: har qator faqat YOPILGAN smenani bildiradi (ochiq holat saqlanmaydi).
/// Joriy smena hosila — u oxirgi yopilgan smenaning `tugashAt` idan hozirgacha
/// bo'lgan oraliq. Tushum oynaga `createdAt` bo'yicha tegishli bo'ladi
/// (`boshlanishAt` < createdAt <= `tugashAt`), chunki drawer'dagi pul
/// yozuvning `sana` siga emas, KIRITILGAN paytiga qarab to'planadi.
model Smena {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Smena YOPILGAN Toshkent kalendar kuni (UTC-midnight).
  sana              DateTime
  /// Kun ichidagi tartib raqami: 1, 2, 3...
  raqam             Int
  /// Oyna boshi — oldingi smena yopilgan payt (birinchisida Toshkent kun boshi).
  boshlanishAt      DateTime
  /// Oyna oxiri — yopilgan payt.
  tugashAt          DateTime
  /// Yopgan xodim. Ism — snapshot (ShiftClose uslubi): xodim keyin
  /// o'chirilsa ham kim topshirgani tarixda ko'rinib turadi.
  yopganUserId      String
  yopganIsm         String?
  /// Oyna summalari — yopish paytida MUZLATILADI (keyin tushum tahrirlansa ham o'zgarmaydi).
  naqd              Int      @default(0)
  click             Int      @default(0)
  qarz              Int      @default(0)
  /// Shu oynada kassadan naqd chiqim (Yozuvlardagi chiqim, faqat naqd to'lov turi).
  naqdChiqim        Int      @default(0)
  /// Smena boshida kassada bo'lgan naqd — oldingi smena qaytim uchun qoldirgani.
  boshlangichQoldiq Int      @default(0)
  /// boshlangichQoldiq + naqd − naqdChiqim (tizim hisobi).
  kutilganNaqd      Int      @default(0)
  /// Xodim kassani SANAB kiritgan naqd.
  sanalganNaqd      Int      @default(0)
  /// sanalganNaqd − kutilganNaqd. Manfiy = KAM — xodim tekshiruvining yuragi.
  farq              Int      @default(0)
  /// Sanalgan puldan kassada ataylab QOLDIRILGANI (qaytim uchun). Qolgani
  /// topshiriladi; shuning uchun keyingi smenaning `boshlangichQoldiq` i shu.
  qoldirilganNaqd   Int      @default(0)
  izoh              String?
  createdAt         DateTime @default(now())

  @@unique([businessId, sana, raqam])
  @@index([businessId, sana])
  @@index([businessId, tugashAt])
}

// ==== HUJJATLAR moduli (Faza 6.6) ====

/// SHARTNOMA REYESTRI.
///
/// Shartnomalar papkada yotardi va muddati o'tib ketgani faqat kimdir
/// eslaganda ma'lum bo'lardi. Endi muddat bazada: `eslatmaKun` kun qolganda
/// bildirishnomalar ro'yxatida ogohlantirish chiqadi.
///
/// Kontragent ataylab ikki xil bog'lanadi: mijoz (`contactId`) yoki
/// ta'minotchi (`supplierId`). Ikkalasi ham null bo'lsa — `kontragent`
/// matni ishlatiladi (kartochkasi yo'q bir martalik tomon uchun).
model Contract {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  raqam      String
  nomi       String
  /// "mijoz" | "taminotchi" | "boshqa"
  turi       String    @default("mijoz")
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// Kartochkasiz kontragent nomi.
  kontragent String?
  summa      Int       @default(0)
  boshlanish DateTime
  tugash     DateTime?
  /// Tugashiga shuncha kun qolganda ogohlantiriladi.
  eslatmaKun Int       @default(30)
  /// "faol" | "tugagan" | "bekor"
  holat      String    @default("faol")
  izoh       String?
  userId     String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@unique([businessId, raqam])
  @@index([businessId, holat, tugash])
  @@index([contactId])
  @@index([supplierId])
}

/// FAYL ILOVASI.
///
/// Ikki rejim bor va ikkalasi ham `url` maydonida yashaydi:
///  - "havola" — tashqi manzil (Google Drive, Telegram). Hech qanday
///    saqlagich talab qilmaydi va har doim ishlaydi;
///  - "blob"  — Vercel Blob'ga yuklangan fayl (token sozlangan bo'lsa).
///
/// `entity` + `entityId` — polimorf bog'lanish. FK qo'yilmagan, chunki bitta
/// jadval to'rt xil yozuvga ilova bo'ladi; egalik `businessId` va xizmat
/// qatlamidagi tekshiruv bilan ta'minlanadi.
model Attachment {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// "transaction" | "debt" | "deal" | "task" | "contract"
  entity     String
  entityId   String
  nomi       String
  url        String
  /// "havola" | "blob"
  saqlagich  String    @default("havola")
  mimeType   String?
  hajm       Int?
  userId     String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([businessId, entity, entityId])
  @@index([businessId, createdAt])
}

// ==== KASSIR KASSASI (kassa topshirish tizimi) ====

/// KASSA TOPSHIRIG'I — kassir qo'lidagi REAL naqd pulning ichki harakati.
///
/// Nega alohida jadval: biznes hisoboti (Kirim/Chiqim/Sof) va kassirning
/// qo'lidagi pul — IKKI BOSHQA narsa. Kassir pulni direktorga topshirsa,
/// biznesning kirimi ham, chiqimi ham, sof balansi ham O'ZGARMASLIGI kerak:
/// pul biznesdan chiqmadi, faqat egasi almashdi. Shuning uchun bu yerda
/// hech qanday `Transaction` YOZILMAYDI va `Account`/`AccountTransfer`
/// (biznes kassalari ledgeri) ham qo'zg'atilmaydi — ular avvalgidek qoladi.
///
/// Kassir qoldig'i BAZADA SAQLANMAYDI, u har doim hisoblanadi
/// (`lib/services/kassirKassa.ts`):
///   qoldiq = naqd kirim(kassir) − naqd chiqim(kassir)
///          + qabul qilingan "berish"lar − qabul qilingan "topshirish"lar.
/// Saqlangan `currentBalance` ustuni ataylab YO'Q: ikkita haqiqat manbai
/// bo'lsa ular ertami-kechmi ajralib ketadi va qaysi biri to'g'ri ekani
/// bilinmay qoladi.
///
/// Ikki yo'nalish bitta jadvalda (`turi`):
///  - "topshirish" — kassir → qabul qiluvchi (direktor tasdig'ini kutadi);
///  - "berish"     — direktor → kassirga boshlang'ich/qaytim puli
///                   (tasdiq talab qilmaydi, darhol "qabul").
///
/// Ismlar snapshot (ShiftClose uslubi): foydalanuvchi keyin o'chirilsa ham
/// kim kimga topshirgani tarixda o'qiladigan bo'lib qoladi.
model CashHandover {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// "topshirish" | "berish"
  turi           String    @default("topshirish")
  /// Pul kimning kassasidan chiqadi (topshirish) yoki kimga beriladi (berish).
  kassirId       String
  kassirIsm      String?
  /// Qabul qilgan/bergan boshqaruvchi. Topshirishda qaror paytida to'ladi.
  qabulId        String?
  qabulIsm       String?
  /// TIZIM hisoblagan kassa qoldig'i — topshirish paytida MUZLATILADI.
  /// Kassir bu raqamni o'zgartira olmaydi (aldashning oldini olish).
  /// "berish"da 0.
  hisoblangan    Int
  /// Haqiqatda topshirilgan (yoki berilgan) naqd.
  topshirilgan   Int
  /// topshirilgan − hisoblangan. Manfiy = KAMOMAD, musbat = ORTIQCHA.
  /// Nol bo'lmagan farq direktor tasdig'isiz yakunlanmaydi.
  farq           Int       @default(0)
  /// "kutilmoqda" | "qabul" | "rad" | "bekor".
  /// Sxemada alohida "kelishmovchilik" holati ATAYLAB yo'q — u `farq != 0`
  /// dan kelib chiqadi va UI'da "Kamomad"/"Ortiqcha" deb ko'rsatiladi.
  /// Ikkinchi haqiqat manbai bo'lmasin.
  holat          String    @default("kutilmoqda")
  /// Farq kassir hisobidan CHIQARILDIMI (direktor qarori).
  /// false — kamomad kassirda ochiq qoladi (u hali ham qarzdor).
  /// Ortiqchada har doim true: manfiy kassa qoldig'ining ma'nosi yo'q.
  farqYopildi    Boolean   @default(false)
  /// Kassirning izohi (topshirish paytida).
  izoh           String?
  /// Direktor qarorining izohi (ayniqsa rad etishda).
  qarorIzoh      String?
  topshirilganAt DateTime  @default(now())
  qabulAt        DateTime?
  radAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId, holat, topshirilganAt])
  @@index([businessId, kassirId, topshirilganAt])
}

// ==== MAGAZIN moduli (POS / QR / Barcode) ====

/// MAHSULOT KATEGORIYASI — POS'da tovarni guruhlab ko'rsatish uchun.
///
/// `Category` (kirim/chiqim) modelidan ATAYLAB alohida: u moliyaviy kategoriya
/// bo'lib, hisobot va budjet unga tayanadi. "Ichimliklar", "Non mahsulotlari"
/// kabi tovar guruhlarini o'sha jadvalga aralashtirib yuborish hisobotni
/// buzardi.
model ProductCategory {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  nomi       String
  tartib     Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  products   Product[]

  @@unique([businessId, nomi])
  @@index([businessId, isActive, tartib])
}

/// POS CHEKI — kassada bitta to'lovda sotilgan savat.
///
/// Nega alohida jadval kerak: `Sale` bitta mahsulotni tasvirlaydi. Kassada
/// esa bitta xaridor 10 xil tovar oladi va BITTA to'lov qiladi. Agar har
/// satr uchun alohida kirim tranzaksiya yozilsa, kassa tarixida bitta
/// xariddan 10 ta yozuv paydo bo'lardi.
///
/// Shuning uchun: har satr avvalgidek `Sale` yozuvi bo'lib qoladi (barcha
/// mavjud hisobot, marja va ombor mantig'i O'ZGARISHSIZ ishlaydi), pul
/// harakati esa — bitta tranzaksiya yoki bitta qarz — CHEKDA yuritiladi.
///
/// Bekor qilish ham chek darajasida: kassada yarim chekni qaytarish emas,
/// butun chekni qaytarish qoidasi ishlaydi.
model PosChek {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Biznes ichidagi ketma-ket chek raqami (kassir "125-chek" deb ataydi).
  raqam         Int
  jamiSumma     Int
  /// "naqd" | "karta" | "click" | "qarz". Naqd/karta/click — pul darhol
  /// kassaga tushadi (qaysi kassa — `accountId`), qarz — Debt yaratiladi.
  tolovTuri     String
  /// Pul tushgan kassa (Account) — naqd/karta/click uchun.
  accountId     String?
  /// Chekning yagona kirim tranzaksiyasi (naqd/karta/click).
  transactionId String?
  /// Qarzga sotilganda — yaratilgan qarzdorlik.
  debtId        String?   @unique
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  mijozNomi     String?
  mijozTel      String?
  userId        String
  /// Chek sanasi (UTC yarim tuni) — `Sale.sana` bilan bir xil qoida.
  sana          DateTime
  createdAt     DateTime  @default(now())
  /// Qaytarilgan/bekor qilingan chek — yumshoq o'chirish (tarix saqlanadi).
  deletedAt     DateTime?
  cancelledBy   String?
  cancelReason  String?
  satrlar       Sale[]

  @@unique([businessId, raqam])
  @@index([businessId, deletedAt, sana])
  @@index([businessId, createdAt])
  @@index([contactId])
}

// ===========================================================================
// SUPERADMIN 2.0 — CONTROL CENTER MODELLARI
// ===========================================================================

/// FEATURE FLAG — platforma darajasidagi bayroq ("NEW_POS", "AI_ASSISTANT"...).
///
/// ATAYLAB TENANTSIZ: bayroq global tizim sozlamasi. Ayrim tenantlarga ochish
/// kerak bo'lsa `tenantIdlar` JSON massivi ishlatiladi — alohida jadval emas,
/// chunki bayroq soni o'nlab bo'ladi va so'rov har doim bitta bayroq bo'yicha.
/// `doira`: "GLOBAL" (hammaga) | "TENANT" (faqat ro'yxatdagi tenantlarga).
model FeatureFlag {
  id          String   @id @default(cuid())
  kalit       String   @unique
  nomi        String
  tavsif      String?
  doira       String   @default("GLOBAL")
  yoqilgan    Boolean  @default(false)
  /// Tenant idlari JSON massivi — faqat `doira = "TENANT"` da ishlatiladi.
  tenantIdlar String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([yoqilgan])
}

/// SUPPORT TIKETI — mijoz muammosi bo'yicha superadmin yuritadigan yozuv.
/// holat: "OCHIQ" | "KUTILMOQDA" | "YECHILDI" | "YOPILDI".
/// muhimlik: "PAST" | "ORTA" | "YUQORI" | "KRITIK".
model SupportTicket {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Tiketni ochgan mijoz foydalanuvchisi (superadmin ochsa null).
  userId     String?
  user       User?            @relation("TiketMuallifi", fields: [userId], references: [id], onDelete: SetNull)
  /// Mas'ul superadmin.
  masulId    String?
  masul      User?            @relation("TiketMasuli", fields: [masulId], references: [id], onDelete: SetNull)
  mavzu      String
  tavsif     String
  holat      String           @default("OCHIQ")
  muhimlik   String           @default("ORTA")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  yopilganAt DateTime?
  xabarlar   SupportMessage[]

  @@index([tenantId])
  @@index([holat, createdAt])
  @@index([masulId])
}

/// Tiket yozishmasi. `ichki = true` — faqat superadminlar ko'radigan qayd.
model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  muallifId  String?
  muallif    User?         @relation(fields: [muallifId], references: [id], onDelete: SetNull)
  muallifIsm String
  matn       String
  ichki      Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ==== XODIMLAR KPI / BALL / OYLIK moduli ====
//
// MAQSAD: CRM → SOTUV → XODIM → KPI → BALL → BONUS → OYLIK zanjiri bitta
// avtomatik tizimga ulanadi. Rahbar kalkulyator ochmaydi — xodim kartochkasini
// bosadi va "hozir qancha oylik chiqdi" savolining javobi ekranda turadi.
//
// HAQIQAT MANBAI QOIDASI — bu modulning eng muhim invarianti:
//   · SOTUV bazada TAKRORLANMAYDI. U mavjud kirim tranzaksiyalaridan
//     hisoblanadi (lib/kpi/sotuv.ts) — CRM zakazi kirimga 1-1 bog'langan
//     (Deal.transactionId UNIQUE), ya'ni bir zakaz bir marta sanaladi.
//   · BALL bazada TAKRORLANMAYDI. Joriy ball = boshlang'ich ball + shu oydagi
//     `KpiPointLog` yozuvlari yig'indisi. Alohida "joriy ball" ustuni YO'Q,
//     shuning uchun jurnal bilan ball hech qachon ajralib qolmaydi va
//     "jimgina tahrirlash" imkonsiz (tuzatish faqat qaytarish yozuvi bilan).
//   · Shu ikkisidan kelib chiqib OYLIK ham saqlanmaydi: u har o'qishda qayta
//     hisoblanadi ("Hozirgi hisob"). Oy YOPILGANDA esa `KpiPayroll` snapshot
//     yoziladi va o'sha oy endi manba o'zgarsa ham o'zgarmaydi ("Yakuniy hisob").

/// KPI SOZLAMALARI — bir biznesga bitta yozuv (HrSetting uslubi).
/// Qattiq kodlangan qiymat YO'Q: har biznes o'z planini va qoidasini sozlaydi.
model KpiSetting {
  id              String   @id @default(cuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// MAVSUM oylari — vergul bilan ajratilgan oy raqamlari (1-12).
  /// Default: mart, may–dekabr (aprel va yanvar-fevral mavsumsiz).
  mavsumOylar     String   @default("3,5,6,7,8,9,10,11,12")
  /// Mavsum oyidagi standart sotuv plani (so'm).
  mavsumPlan      Int      @default(100000000)
  /// Mavsumsiz oydagi standart sotuv plani (so'm).
  mavsumsizPlan   Int      @default(80000000)
  /// Plan bajarilsa beriladigan qo'shimcha (so'm).
  planBonus       Int      @default(1000000)
  /// Har vazifa har oy shu balldan boshlanadi.
  boshlangichBall Int      @default(100)
  /// ODDIY jarimalarda bir vazifa uchun BIR KUNDA maksimal ayirish (ball).
  /// KRITIK (ishonch) holatlari bu limitga KIRMAYDI.
  kunlikLimit     Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// PROGRESSIV SOTUV BONUSI INTERVALI.
///
/// Umumiy summaga BITTA foiz qo'llanmaydi — har interval o'z foizi bilan
/// hisoblanadi (lib/kpi/hisob.ts). `gacha` null — yuqori chegara yo'q.
/// `foiz` — YUZDAN BIR aniqlikda butun son (2% → 200), chunki loyihada
/// float taqiqlangan; hisob `summa × foiz / 10000` ko'rinishida butun qoladi.
model KpiSalesBracket {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dan        Int
  gacha      Int?
  foiz       Int
  tartib     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId, tartib])
}

/// BALL → VAZIFA HAQI FOIZI jadvali (100 ball → 110%, 39 → 0% ...).
/// Chegaralar INCLUSIVE: minBall ≤ ball ≤ maxBall.
model KpiScoreRule {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  minBall    Int
  maxBall    Int
  /// Yuzdan bir aniqlikda (110% → 11000).
  foiz       Int
  tartib     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([businessId, tartib])
}

/// KPI VAZIFASI — oylik haqi biriktirilgan doimiy majburiyat
/// ("Mijoz bilan aloqa", "Baza va hisob yuritish", ...).
///
/// CRM `Task` bilan ARALASHTIRILMAYDI: `Task` — bir martalik topshiriq
/// (muddat, holat, bajarildi); bu esa HAR OY takrorlanadigan majburiyat,
/// bajarilishi ball bilan o'lchanadi va pulga aylanadi.
/// O'chirish YUMSHOQ (`deletedAt`) — ball tarixi va yopilgan oylik
/// snapshotlari havolasiz qolmasin.
model KpiTask {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nomi       String
  izoh       String?
  /// Vazifa uchun to'liq bajarilgandagi OYLIK haq (so'm).
  oylikHaq   Int       @default(0)
  aktiv      Boolean   @default(true)
  tartib     Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  biriktiruvlar KpiTaskAssignment[]
  presetlar     KpiPenaltyPreset[]
  ballLoglari   KpiPointLog[]
  oylikQatorlar KpiPayrollItem[]

  @@index([businessId, aktiv, tartib])
}

/// VAZIFA BIRIKTIRUVI — qaysi xodim qaysi vazifani bajaradi.
/// `aktiv=false` — biriktiruv olib tashlangan, LEKIN yozuv qoladi: o'tgan
/// oylardagi ball tarixi va oylik hisobi havolasiz qolmasligi kerak.
model KpiTaskAssignment {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taskId     String
  task       KpiTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  aktiv      Boolean  @default(true)
  /// Kim biriktirgan (User.id). FK ataylab yo'q (EmployeeBonus.userId uslubi).
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([taskId, employeeId])
  @@index([businessId, employeeId, aktiv])
  @@index([employeeId])
  @@index([taskId])
}

/// TAYYOR JARIMA SABABI (preset) — modalda bir bosishda tanlanadi.
/// `taskId` null — GLOBAL sabab (masalan "Yolg'on ma'lumot berish").
/// `kritik=true` — ISHONCH buzilishi: kunlik limitga KIRMAYDI.
model KpiPenaltyPreset {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  taskId     String?
  task       KpiTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sabab      String
  /// Ayiriladigan ball — MUSBAT son sifatida saqlanadi (UI "-4" ko'rsatadi).
  ball       Int
  kritik     Boolean  @default(false)
  aktiv      Boolean  @default(true)
  tartib     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, aktiv, tartib])
  @@index([taskId])
}

/// BALL TRANZAKSIYASI — audit jurnali va AYNI PAYTDA ballning yagona manbai.
///
/// Yozuv TAHRIRLANMAYDI va O'CHIRILMAYDI. Xato kiritilgan bo'lsa "qaytarish"
/// yozuvi yaratiladi (`turi="qaytarish"`, `ball` musbat, `bekorQilinganId`
/// asl yozuvga ishora qiladi) — asl yozuv tarixda ko'rinib turadi.
///
/// `oy` — ball qaysi oyga tegishli ("YYYY-MM"). Ball keyingi oyga
/// KO'CHMAYDI: yangi oy yana boshlang'ich balldan boshlanadi.
model KpiPointLog {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskId          String
  task            KpiTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// "YYYY-MM" — `sana` dan kelib chiqadi, lekin so'rovlar shu ustun bo'yicha
  /// kesiladi (indeks bilan bitta o'qishda butun oy ko'tariladi).
  oy              String
  sana            DateTime
  /// Manfiy — ayirish, musbat — qaytarish. Nol bo'lmaydi.
  ball            Int
  /// Yozuv yozilgan paytdagi ball (audit ko'rinishi: 100 → 97).
  ballOldin       Int
  ballKeyin       Int
  sabab           String
  izoh            String?
  /// "jarima" | "qaytarish"
  turi            String   @default("jarima")
  /// Ishonch/kritik holat — kunlik limitga kirmaydi.
  kritik          Boolean  @default(false)
  /// Qaysi presetdan olingan (qo'lda kiritilgan bo'lsa null).
  presetId        String?
  /// Qaytarish yozuvi bo'lsa — qaysi yozuvni bekor qiladi.
  /// @unique — bitta yozuv IKKI marta qaytarilmaydi (baza darajasidagi kafolat).
  bekorQilinganId String?  @unique
  /// Kim yozdi (User.id). FK ataylab yo'q — foydalanuvchi o'chirilsa ham
  /// audit tarixi buzilmasin.
  userId          String
  /// Kim yozgani — snapshot ism (tarixda "Rahbar: Umar" ko'rinadi).
  userIsm         String?
  createdAt       DateTime @default(now())

  /// Asosiy o'qish: bitta xodimning bitta oydagi barcha ball harakati.
  @@index([businessId, employeeId, oy])
  /// Dashboard: butun biznesning oy kesimi (barcha xodim ballari bir o'qishda).
  @@index([businessId, oy])
  /// Kunlik limit tekshiruvi: (xodim, vazifa, sana).
  @@index([employeeId, taskId, sana])
  @@index([taskId])
}

/// XODIMNING OYLIK SOTUV PLANI — standart plandan FARQ qilsa yoziladi.
/// Yozuv bo'lmasa `KpiSetting` dagi mavsum/mavsumsiz plan qo'llanadi.
/// Har oy alohida: keyingi oy plan o'zgarsa o'tgan oy statistikasi buzilmaydi.
model KpiSalesTarget {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "YYYY-MM"
  oy         String
  maqsad     Int
  /// Shu oyga xos plan bonusi. Null — sozlamadagi umumiy qiymat.
  planBonus  Int?
  izoh       String?
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, oy])
  @@index([businessId, oy])
}

/// OY YOPILGANDAGI OYLIK SNAPSHOT'i — bir xodim, bir oy.
///
/// Yozuv YO'Q bo'lsa oy hali ochiq: hisob real vaqtda manbadan chiqadi
/// ("Hozirgi hisob", DTO'da holat = "QORALAMA"). Yozuv paydo bo'lgach CRM
/// yoki zakaz keyin o'zgarsa ham bu raqamlar O'ZGARMAYDI — tuzatish faqat
/// `KpiPayrollAdjustment` orqali, ko'rinadigan qatordek yoziladi.
///
/// Mavjud `Payroll` (stavka + davomat vedomosti) bilan ALMASHTIRILMAYDI:
/// u boshqa hisob sxemasi (kunlik/oylik stavka, avans, davomat jarimasi).
/// Bu esa KPI sxemasi (vazifa haqi + sotuv bonusi + plan bonusi).
model KpiPayroll {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// "YYYY-MM"
  oy             String
  /// Snapshot paytidagi hisoblangan sotuv (so'm).
  sotuv          Int       @default(0)
  /// Snapshot paytidagi sotuv plani (so'm).
  plan           Int       @default(0)
  vazifaHaqi     Int       @default(0)
  sotuvBonusi    Int       @default(0)
  planBonusi     Int       @default(0)
  /// Tasdiqdan keyingi tuzatishlar yig'indisi (KpiPayrollAdjustment).
  tuzatish       Int       @default(0)
  /// vazifaHaqi + sotuvBonusi + planBonusi + tuzatish.
  jami           Int       @default(0)
  /// "HISOBLANDI" | "TASDIQLANDI" | "TOLANDI".
  /// Yozuv umuman bo'lmasa — "QORALAMA" (DTO darajasida).
  holat          String    @default("HISOBLANDI")
  hisoblanganAt  DateTime  @default(now())
  tasdiqlaganId  String?
  tasdiqlanganAt DateTime?
  tolaganId      String?
  tolanganAt     DateTime?
  tolanganSumma  Int?
  izoh           String?
  /// Kim yopgan (User.id) — FK ataylab yo'q.
  userId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  qatorlar    KpiPayrollItem[]
  tuzatishlar KpiPayrollAdjustment[]

  @@unique([employeeId, oy])
  @@index([businessId, oy, holat])
}

/// OYLIK SNAPSHOT QATORI — har vazifa bo'yicha ball va hisoblangan haq.
/// Vazifa nomi va oylik haqi SNAPSHOT sifatida ko'chiriladi: keyin vazifa
/// nomi yoki narxi o'zgarsa yopilgan oy hisoboti o'zgarmaydi.
model KpiPayrollItem {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollId   String
  payroll     KpiPayroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  /// Vazifa yumshoq o'chirilsa ham havola qoladi; hard delete'da null.
  taskId      String?
  task        KpiTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskNomi    String
  oylikHaq    Int
  ball        Int
  /// Yuzdan bir aniqlikda qo'llangan foiz (85% → 8500).
  foiz        Int
  hisoblangan Int

  @@index([payrollId])
  @@index([taskId])
}

/// YOPILGAN OYLIKKA TUZATISH — snapshot RAQAMI o'zgartirilmaydi, tuzatish
/// ALOHIDA qator bo'lib qo'shiladi (kim, qachon, nega — ko'rinib turadi).
model KpiPayrollAdjustment {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payrollId  String
  payroll    KpiPayroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  /// Musbat — qo'shimcha, manfiy — ushlab qolish.
  summa      Int
  sabab      String
  userId     String
  userIsm    String?
  createdAt  DateTime   @default(now())

  @@index([payrollId])
  @@index([businessId, createdAt])
}
