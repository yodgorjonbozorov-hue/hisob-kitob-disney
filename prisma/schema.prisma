generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite native enumlarni qo'llab-quvvatlamaydi, shuning uchun rol/turi String sifatida
// saqlanadi va zod orqali ilova darajasida "admin"|"kassir" / "kirim"|"chiqim" bilan cheklanadi.

/// Tenant — mijoz kompaniya (obuna egasi). Har bir tenant o'z bizneslari va
/// foydalanuvchilariga ega; tenantlar bir-birining ma'lumotini hech qachon ko'rmaydi.
/// status: "TRIAL" | "ACTIVE" | "PAST_DUE" | "BLOCKED" (zod bilan cheklanadi).
model Tenant {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  status           String         @default("TRIAL")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  plan             String         @default("STANDARD")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  businesses       Business[]
  users            User[]
  subscriptions    Subscription[]
  payments         Payment[]
  modules          TenantModule[]

  @@index([status])
}

/// Tenant qaysi modullarni yoqqani. Modul katalogi kodda (lib/modules/registry.ts) —
/// bu jadval faqat yoqilganlik holati. Core modullar yozuvsiz ham yoqilgan hisoblanadi.
model TenantModule {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  code       String   // registry'dagi modul kodi (masalan "OMBOR")
  isActive   Boolean  @default(true)
  sozlamalar String?  // modul-spetsifik sozlamalar (JSON)
  createdAt  DateTime @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Obuna davri — har tasdiqlangan to'lov bitta davr yozuvini yaratadi (tarix uchun).
/// status: "ACTIVE" | "EXPIRED" | "CANCELLED" (zod bilan cheklanadi).
model Subscription {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  plan        String
  status      String   @default("ACTIVE")
  periodStart DateTime
  periodEnd   DateTime
  amount      Int
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([status])
}

/// To'lov yozuvi. provider: "MANUAL" | "PAYME" | "CLICK";
/// status: "PENDING" | "CONFIRMED" | "REJECTED". MANUAL'da SUPERADMIN tasdiqlaydi.
model Payment {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  amount     Int
  provider   String    @default("MANUAL")
  externalId String?
  status     String    @default("PENDING")
  izoh       String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([status])
}

/// Biznes (kompaniya bo'limi). Har bir biznesning o'z kategoriyalari, tranzaksiyalari va dashboard'i.
model Business {
  id           String        @id @default(cuid())
  nomi         String
  isActive     Boolean       @default(true)
  // Ombor (inventar) tizimi yoqilganmi — tovar sotadigan bizneslar uchun (masalan Salyut).
  omborli      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  categories   Category[]
  transactions Transaction[]
  users        User[]
  products     Product[]
  budgets      Budget[]
  shiftCloses  ShiftClose[]
  recurrings   RecurringTransaction[]
  sales        Sale[]
  debts        Debt[]
  stockEntries StockEntry[]
  debtPayments DebtPayment[]
  auditLogs    AuditLog[]

  @@index([tenantId])
}

model User {
  id                String        @id @default(cuid())
  ism               String
  login             String        @unique
  parolHash         String
  // rol: "SUPERADMIN" | "OWNER" | "ADMIN" | "CASHIER" | "SELLER" (zod bilan cheklanadi).
  rol               String
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  lastLoginAt       DateTime?
  // Seed parollarini birinchi kirishda majburiy almashtirish uchun.
  mustChangePassword Boolean      @default(false)
  transactions      Transaction[]

  // Tenant a'zoligi. Faqat SUPERADMIN (platforma egasi) uchun null.
  tenantId          String?
  tenant            Tenant?       @relation(fields: [tenantId], references: [id])

  // Kassir bitta biznesga biriktiriladi; owner/admin/seller uchun null (tenant ichidagi barcha bizneslar).
  businessId        String?
  business          Business?     @relation(fields: [businessId], references: [id])

  telegramChatId    String?       @unique
  linkCode          String?
  linkCodeExpiresAt DateTime?

  @@index([businessId])
  @@index([tenantId])
}

/// Kalit-qiymat ko'rinishidagi tizim sozlamalari (masalan, oxirgi yuborilgan oylik hisobot).
model AppSetting {
  key   String @id
  value String
}

model Category {
  id           String        @id @default(cuid())
  nomi         String
  turi         String
  tartib       Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id])
  transactions Transaction[]
  budgets      Budget[]
  recurrings   RecurringTransaction[]

  @@unique([nomi, turi, businessId])
  @@index([turi, isActive])
  @@index([businessId])
}

model Transaction {
  id         String   @id @default(cuid())
  turi       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  summa      Int
  sana       DateTime
  izoh       String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  filial     String?
  createdAt  DateTime @default(now())
  // Soft delete — o'chirilgan yozuv shu vaqt bilan belgilanadi (undo/savat uchun).
  deletedAt  DateTime?

  @@index([sana])
  @@index([turi])
  @@index([categoryId])
  @@index([businessId])
  @@index([userId])
  @@index([deletedAt])
}

/// Audit izi — har bir muhim o'zgarish (kim, nima, oldin→keyin) yoziladi.
model AuditLog {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  userId     String?
  userIsm    String?
  action     String // "create" | "update" | "delete" | "restore"
  entity     String // "transaction" | "user" | "category" | "sale" | "debt"
  entityId   String
  before     String? // JSON
  after      String? // JSON
  ip         String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([entity])
  @@index([createdAt])
}

/// Kassir kun yakuni — kutilgan naqd (kirim) vs sanalgan naqd, farq.
model ShiftClose {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  userId       String
  userIsm      String?
  sana         DateTime
  kutilganNaqd Int
  sanalganNaqd Int
  farq         Int
  izoh         String?
  createdAt    DateTime @default(now())

  @@index([businessId, sana])
}

/// Takroriy tranzaksiya andozasi — har oy `kun` sanasida avtomatik yaratiladi.
model RecurringTransaction {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  turi          String
  summa         Int
  izoh          String?
  kun           Int // oyning kuni (1-28)
  isActive      Boolean  @default(true)
  lastGenerated String? // oxirgi yaratilgan oy "YYYY-MM"
  createdAt     DateTime @default(now())

  @@index([businessId])
}

/// Kategoriya bo'yicha oylik budjet (limit). "oy" formati: "2026-07".
model Budget {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  oy         String
  limitSumma Int
  createdAt  DateTime @default(now())

  @@unique([categoryId, oy])
  @@index([businessId, oy])
}

// ==== Ombor (inventar) moduli — faqat omborli bizneslar uchun ====

/// Mahsulot turi (masalan salyut turlari) + narxlar + joriy qoldiq.
model Product {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id])
  nomi         String
  kelganNarx   Int          @default(0) // tannarx (birlik)
  sotuvNarx    Int          @default(0) // sotuv narxi (birlik)
  miqdor       Int          @default(0) // ombordagi joriy qoldiq
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  stockEntries StockEntry[]
  sales        Sale[]

  @@index([businessId])
}

/// Ombor kirimi — mahsulot qoldig'ini oshiradi (chiqim tranzaksiya yaratmaydi).
model StockEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  miqdor     Int
  birlikNarx Int // o'sha paytdagi tannarx snapshot
  userId     String
  izoh       String?
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([productId])
}

/// Sotuv — mahsulot qoldig'ini kamaytiradi. Naqd → kirim tranzaksiya; qarz → Debt.
model Sale {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  miqdor        Int
  birlikNarx    Int // sotuv narxi snapshot
  tannarx       Int // kelgan narx snapshot (marja hisobi uchun)
  jamiSumma     Int
  tolovTuri     String // "naqd" | "qarz"
  mijozNomi     String?
  mijozTel      String?
  userId        String
  transactionId String? // naqd bo'lsa bog'langan kirim tranzaksiya
  createdAt     DateTime @default(now())
  debt          Debt?

  @@index([businessId])
  @@index([productId])
}

/// Qarzdorlik — qarzga sotuvdan yaratiladi; to'lovlar bilan kamayadi.
model Debt {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id])
  saleId     String?       @unique
  sale       Sale?         @relation(fields: [saleId], references: [id])
  mijozNomi  String
  mijozTel   String?
  jamiSumma  Int
  tolangan   Int           @default(0)
  isYopilgan Boolean       @default(false)
  izoh       String?
  userId     String
  createdAt  DateTime      @default(now())
  payments   DebtPayment[]

  @@index([businessId])
}

/// Qarz to'lovi — kirim tranzaksiya yaratadi va qarzni kamaytiradi.
model DebtPayment {
  id            String   @id @default(cuid())
  debtId        String
  debt          Debt     @relation(fields: [debtId], references: [id])
  businessId    String
  business      Business @relation(fields: [businessId], references: [id])
  summa         Int
  userId        String
  transactionId String?
  createdAt     DateTime @default(now())

  @@index([debtId])
  @@index([businessId])
}
