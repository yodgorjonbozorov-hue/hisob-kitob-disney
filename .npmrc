# @prisma/adapter-libsql peer sifatida @libsql/client ^0.8 ni so'raydi, loyihada esa
# ^0.14 ishlatiladi (adapter u bilan ham ishlaydi). npm 7+ buni ERESOLVE xatosi bilan
