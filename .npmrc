# @prisma/adapter-libsql@5.22 peer sifatida @libsql/client <=0.8 ni so'raydi,
# loyihada esa 0.14 ishlatiladi (Turso'ning yangi mijozi). Bu to'qnashuv tufayli
# oddiy `npm install` ERESOLVE bilan yiqiladi.
#
# Shu faylsiz build faqat Vercel loyihasining "Install Command" sozlamasi
# (npm install --legacy-peer-deps) hisobiga o'tardi — ya'ni ko'rinmas bog'liqlik.
# Bu yerda yozib qo'yilgani uchun har qanday muhitda bir xil o'rnatiladi.
legacy-peer-deps=true
