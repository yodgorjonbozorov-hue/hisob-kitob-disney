{
  "name": "disney-navoiy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-migrate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:seed": "node -r ts-node/register prisma/seed.ts",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:apply": "node scripts/db-migrate.mjs",
    "bot": "node -r ts-node/register src/bot/index.ts",
    "superadmin:create": "node -r ts-node/register scripts/create-superadmin.ts",
    "test:isolation": "node -r ts-node/register tests/isolation.test.ts",
    "test:signup": "node -r ts-node/register tests/signup.test.ts",
    "test:billing": "node -r ts-node/register tests/billing.test.ts",
    "test:superadmin": "node -r ts-node/register tests/superadmin.test.ts",
    "test:modules": "node -r ts-node/register tests/modules.test.ts",
    "test:crm": "node -r ts-node/register tests/crm.test.ts"
  },
  "prisma": {
    "seed": "node -r ts-node/register prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@prisma/adapter-libsql": "^5.20.0",
    "@prisma/client": "^5.20.0",
    "@react-pdf/renderer": "^3.4.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "grammy": "^1.30.0",
    "iron-session": "^8.0.3",
    "lucide-react": "^1.27.0",
    "next": "^14.2.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
